                        <div class="text-emerald-400">struct OrganicPixelBlock {</div>
                        <div class="pl-3 text-emerald-100">atpLevel: f32,       <span class="text-slate-400">// Metabolic energy flux</span></div>
                        <div class="pl-3 text-emerald-100">membraneTension: f32,<span class="text-slate-400">// Fluid ripple propagation</span></div>
