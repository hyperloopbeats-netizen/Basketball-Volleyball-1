    <!-- Master Application Script -->
    <script>
        lucide.createIcons();

        // Update Hardware Clock
        setInterval(() => {
            document.getElementById('os-clock').innerText = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }, 1000);

        // =========================================================================
        // 1. QUANTUM ORGANIC SCREEN OS v10.5 - LIVING TISSUE STATE
        // =========================================================================
        const simCanvas = document.getElementById('simCanvas');
        const membraneCanvas = document.getElementById('membraneOverlayCanvas');
        const membraneCtx = membraneCanvas.getContext('2d');

        let scene, camera, renderer;
        let tissueMesh;
        let tissueUniforms;
        let biolumeOrbs = [];
        let cellularMatrixEnabled = true;

        const organicOrganism = {
            atpLevel: 98,
            mitosisRate: 1.0,
            membraneTension: 0.45,
            bioluminescence: 88.2,
            heartRate: 72,
            tissueScale: 1024,
            touchRippleX: 0.5,
            touchRippleY: 0.5,
            touchRippleTime: 0.0
        };

        // Real-Time Frame Telemetry
        let lastFrameTime = performance.now();
        let frameCount = 0;
        let lastFpsUpdate = performance.now();
        let currentFps = 120;

        // =========================================================================
        // 2. INITIALIZE 3D LIVING TISSUE & 1-PIXEL SYSTEM BLOCK
        // =========================================================================
        function initOrganicScreen() {
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020617, 0.025);

            const wrapper = document.getElementById('canvas-wrapper');
            const width = wrapper.clientWidth || 400;
            const height = wrapper.clientHeight || 500;

            camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, -18, 26);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ canvas: simCanvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            resizeMembraneCanvas(width, height);

            // Create Living Tissue Surface (Plane with custom organic vertex displacement shader)
            const tissueGeo = new THREE.PlaneGeometry(24, 24, 64, 64);
            
            tissueUniforms = {
                uTime: { value: 0 },
                uTouchPos: { value: new THREE.Vector2(0.5, 0.5) },
                uTouchTime: { value: -10.0 },
                uMitosis: { value: 1.0 },
                uBiolume: { value: 0.88 }
            };

            const tissueMat = new THREE.ShaderMaterial({
                uniforms: tissueUniforms,
                wireframe: false,
                transparent: true,
                side: THREE.DoubleSide,
                vertexShader: `
                    uniform float uTime;
                    uniform vec2 uTouchPos;
                    uniform float uTouchTime;
                    uniform float uMitosis;
                    varying vec2 vUv;
                    varying float vElevation;
                    varying vec3 vNormal;

                    void main() {
                        vUv = uv;
                        vNormal = normal;

                        vec3 pos = position;

                        // Organic biological wave displacement
                        float wave1 = sin(pos.x * 0.4 + uTime * 1.8) * cos(pos.y * 0.4 + uTime * 1.5);
                        float wave2 = sin(length(pos.xy) * 0.6 - uTime * 2.2);
                        float elevation = (wave1 * 0.8 + wave2 * 0.6) * uMitosis;

                        // Touch/drag ripple deformation
                        float distToTouch = distance(uv, uTouchPos);
                        float ripple = sin(distToTouch * 18.0 - (uTime - uTouchTime) * 8.0) * exp(-distToTouch * 4.0);
                        if (uTime - uTouchTime < 3.0) {
                            elevation += ripple * 2.2;
                        }

                        pos.z += elevation;
                        vElevation = elevation;

                        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
                    }
                `,
                fragmentShader: `
                    uniform float uTime;
                    uniform float uBiolume;
                    varying vec2 vUv;
                    varying float vElevation;
                    varying vec3 vNormal;

                    void main() {
                        // Bioluminescent synthetic cellular tissue coloring
                        vec3 bioCyan = vec3(0.06, 0.95, 0.75);
                        vec3 bioEmerald = vec3(0.05, 0.65, 0.42);
                        vec3 bioDark = vec3(0.02, 0.08, 0.15);

                        float mixFactor = smoothstep(-1.5, 1.5, vElevation);
                        vec3 tissueColor = mix(bioDark, bioEmerald, mixFactor);
                        tissueColor = mix(tissueColor, bioCyan, vElevation * 0.4 + 0.3);

                        // Organic grid/cellular membrane borders
                        vec2 grid = abs(fract(vUv * 16.0 - 0.5) - 0.5) / fwidth(vUv * 16.0);
                        float line = min(grid.x, grid.y);
                        float membraneCell = 1.0 - min(line, 1.0);

                        vec3 finalColor = mix(tissueColor, bioCyan * 1.6, membraneCell * 0.45);
                        float pulse = 0.85 + 0.15 * sin(uTime * 3.0 + vUv.x * 6.0);

                        gl_FragColor = vec4(finalColor * pulse * uBiolume, 0.92);
                    }
                `
            });

            tissueMesh = new THREE.Mesh(tissueGeo, tissueMat);
            scene.add(tissueMesh);

            // Floating Bioluminescent Orbs (ATP Photon Particles)
            const orbGeo = new THREE.SphereGeometry(0.18, 16, 16);
            for (let i = 0; i < 32; i++) {
                const orbMat = new THREE.MeshBasicMaterial({
                    color: i % 2 === 0 ? 0x10b981 : 0x38bdf8,
                    transparent: true,
                    opacity: 0.75
                });
                const orb = new THREE.Mesh(orbGeo, orbMat);
                orb.position.set(
                    (Math.random() - 0.5) * 20,
                    (Math.random() - 0.5) * 20,
                    Math.random() * 3 + 1
                );
                scene.add(orb);
                biolumeOrbs.push({
                    mesh: orb,
                    speedX: (Math.random() - 0.5) * 0.02,
                    speedY: (Math.random() - 0.5) * 0.02,
                    speedZ: Math.random() * 0.015
                });
            }

            setupTissueInteractions();
            window.addEventListener('resize', onViewportResize);
        }

        function resizeMembraneCanvas(width, height) {
            const dpr = Math.min(window.devicePixelRatio, 2);
            membraneCanvas.width = width * dpr;
            membraneCanvas.height = height * dpr;
            membraneCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function onViewportResize() {
            const wrapper = document.getElementById('canvas-wrapper');
            if (!wrapper || !renderer || !camera) return;
            const width = wrapper.clientWidth;
            const height = wrapper.clientHeight;
            if (width === 0 || height === 0) return;

            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
            resizeMembraneCanvas(width, height);
        }

        // =========================================================================
        // 3. BIOLUMINESCENT MEMBRANE RIPPLE OVERLAY (SCREEN-SPACE CANVAS)
        // =========================================================================
        function renderMembraneRippleOverlay(timeSec) {
            const width = membraneCanvas.clientWidth;
            const height = membraneCanvas.clientHeight;
            membraneCtx.clearRect(0, 0, width, height);

            if (!cellularMatrixEnabled || width === 0 || height === 0) return;

            const cols = 12;
            const rows = 16;
            const cellW = width / cols;
            const cellH = height / rows;

            const touchPxX = organicOrganism.touchRippleX * width;
            const touchPxY = (1.0 - organicOrganism.touchRippleY) * height;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const x = c * cellW;
                    const y = r * cellH;
                    const midX = x + cellW * 0.5;
                    const midY = y + cellH * 0.5;

                    const dist = Math.hypot(midX - touchPxX, midY - touchPxY);
                    const touchAge = timeSec - organicOrganism.touchRippleTime;
                    const waveIntensity = touchAge < 3.0 ? Math.max(0, 1.0 - dist / 220) * Math.sin(touchAge * 10 - dist * 0.05) : 0;

                    const organicPulse = 0.35 + 0.25 * Math.sin(timeSec * 2.5 + c * 0.4 + r * 0.4);
                    const alpha = Math.min(0.35, Math.abs(waveIntensity) * 0.8 + organicPulse * 0.2);

                    // Draw organic cellular membrane node
                    membraneCtx.fillStyle = waveIntensity > 0.1 ? `rgba(52, 211, 153, ${alpha * 1.5})` : `rgba(16, 185, 129, ${alpha * 0.6})`;
                    membraneCtx.beginPath();
                    membraneCtx.arc(midX, midY, 2.5 + Math.abs(waveIntensity) * 3.0, 0, Math.PI * 2);
                    membraneCtx.fill();

                    // Draw connecting micro-synapse threads
                    if (c < cols - 1) {
                        membraneCtx.strokeStyle = `rgba(16, 185, 129, ${alpha * 0.35})`;
                        membraneCtx.lineWidth = 1;
                        membraneCtx.beginPath();
                        membraneCtx.moveTo(midX, midY);
                        membraneCtx.lineTo(midX + cellW, midY);
                        membraneCtx.stroke();
                    }
                }
            }
        }

        // =========================================================================
        // 4. INTERACTIVE TOUCH & DRAG STIMULATION
        // =========================================================================
        function setupTissueInteractions() {
            const handleInteract = (clientX, clientY) => {
                const rect = simCanvas.getBoundingClientRect();
                const x = (clientX - rect.left) / rect.width;
                const y = (clientY - rect.top) / rect.height;

                organicOrganism.touchRippleX = x;
                organicOrganism.touchRippleY = y;
                organicOrganism.touchRippleTime = performance.now() * 0.001;
                organicOrganism.membraneTension = 0.85;

                if (tissueUniforms) {
                    tissueUniforms.uTouchPos.value.set(x, y);
                    tissueUniforms.uTouchPos.value.set(x, y);
                    tissueUniforms.uTouchTime.value = organicOrganism.touchRippleTime;
                }
            };

            simCanvas.addEventListener('mousedown', e => handleInteract(e.clientX, e.clientY));
            simCanvas.addEventListener('mousemove', e => {
                if (e.buttons === 1) handleInteract(e.clientX, e.clientY);
            });
            simCanvas.addEventListener('touchstart', e => {
                if (e.touches.length > 0) handleInteract(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
            simCanvas.addEventListener('touchmove', e => {
                if (e.touches.length > 0) handleInteract(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
        }

        // =========================================================================
        // 5. ORGANIC CONTROLS & FUNCTIONS
        // =========================================================================
        function triggerMitosis() {
            organicOrganism.mitosisRate = organicOrganism.mitosisRate === 1.0 ? 1.65 : 1.0;
            if (tissueUniforms) tissueUniforms.uMitosis.value = organicOrganism.mitosisRate;
            document.getElementById('tissue-state-badge').innerText = organicOrganism.mitosisRate > 1.0 ? "MITOSIS SURGE (1.65x)" : "HOMEOSTASIS (100%)";
            document.getElementById('tele-mitosis').innerText = `${organicOrganism.mitosisRate}x ACTIVE`;
        }

        function triggerNutrientSurge() {
            organicOrganism.atpLevel = Math.min(100, organicOrganism.atpLevel + 15);
            organicOrganism.membraneTension = 0.95;
            document.getElementById('atp-readout').innerText = `ATP: ${Math.round(organicOrganism.atpLevel)}%`;
            document.getElementById('metric-atp').innerText = `22.4 µmol/s`;
        }

        function pulseBioluminescence() {
            organicOrganism.bioluminescence = organicOrganism.bioluminescence > 100 ? 88.2 : 125.0;
            if (tissueUniforms) tissueUniforms.uBiolume.value = organicOrganism.bioluminescence / 88.2;
            document.getElementById('metric-lum').innerText = `${organicOrganism.bioluminescence.toFixed(1)} LUMEN`;
        }

        function resetTissue() {
            organicOrganism.mitosisRate = 1.0;
            organicOrganism.membraneTension = 0.45;
            organicOrganism.bioluminescence = 88.2;
            organicOrganism.atpLevel = 98;
            if (tissueUniforms) {
                tissueUniforms.uMitosis.value = 1.0;
                tissueUniforms.uBiolume.value = 1.0;
            }
            document.getElementById('tissue-state-badge').innerText = "HOMEOSTASIS (100%)";
            document.getElementById('tele-mitosis').innerText = "1.0x STABLE";
            document.getElementById('atp-readout').innerText = "ATP: 98%";
        }

        function toggleCellularMatrix() {
            cellularMatrixEnabled = !cellularMatrixEnabled;
            const label = document.getElementById('matrix-toggle-label');
            const btn = document.getElementById('btn-matrix-toggle');
            if (cellularMatrixEnabled) {
                label.innerText = 'MATRIX: ON';
                btn.classList.add('border-emerald-400/60', 'text-emerald-200');
                btn.classList.remove('border-slate-600', 'text-slate-400');
            } else {
                label.innerText = 'MATRIX: OFF';
                btn.classList.remove('border-emerald-400/60', 'text-emerald-200');
                btn.classList.add('border-slate-600', 'text-slate-400');
            }
        }

        function setTissueScale(scale) {
            organicOrganism.tissueScale = scale;
            document.getElementById('core-scale-label').innerText = `${scale.toLocaleString()} CELLS (1-PX BLOCK)`;
            document.getElementById('tree-cells').innerText = `${scale.toLocaleString()} Nodes`;
            document.getElementById('metric-density').innerText = `${scale.toLocaleString()} NODES`;

            [256, 512, 1024, 4096].forEach(s => {
                const btn = document.getElementById(`scale-btn-${s}`);
                if (btn) {
                    if (s === scale) {
                        btn.classList.add('active-pill', 'text-emerald-200', 'font-bold');
                    } else {
                        btn.classList.remove('active-pill', 'text-emerald-200', 'font-bold');
                    }
                }
            });
        }

        // =========================================================================
        // 6. MASTER RENDER & ANIMATION LOOP
        // =========================================================================
        function animateOrganicScreen(now) {
            requestAnimationFrame(animateOrganicScreen);

            const timeSec = now * 0.001;
            const dt = Math.min((now - lastFrameTime) * 0.001, 0.05);
            lastFrameTime = now;

            // Calculate real FPS telemetry
            frameCount++;
            if (now - lastFpsUpdate >= 500) {
                currentFps = Math.min(120, Math.round((frameCount * 1000) / (now - lastFpsUpdate)));
                document.getElementById('fps-readout').innerText = `${currentFps} FPS`;
                frameCount = 0;
                lastFpsUpdate = now;
            }

            // Decay membrane tension smoothly
            if (organicOrganism.membraneTension > 0.45) {
                organicOrganism.membraneTension -= dt * 0.1;
            } else {
                organicOrganism.membraneTension = 0.45;
            }

            // Update tissue shader time
            if (tissueUniforms) {
                tissueUniforms.uTime.value = timeSec;
            }

            // Animate bioluminescent ATP photon orbs
            biolumeOrbs.forEach(orb => {
                orb.mesh.position.x += orb.speedX;
                orb.mesh.position.y += orb.speedY;
                orb.mesh.position.z += Math.sin(timeSec + orb.mesh.position.x) * 0.005;

                if (Math.abs(orb.mesh.position.x) > 12) orb.speedX *= -1;
                if (Math.abs(orb.mesh.position.y) > 12) orb.speedY *= -1;
            });

            // Sync 1-Pixel Register HUD in CORE tab
            document.getElementById('reg-r').innerText = (organicOrganism.atpLevel / 100).toFixed(3);
            document.getElementById('reg-g').innerText = organicOrganism.mitosisRate.toFixed(3);
            document.getElementById('reg-b').innerText = (organicOrganism.membraneTension - 0.45).toFixed(3);
            document.getElementById('reg-a').innerText = (organicOrganism.bioluminescence / 100).toFixed(3);

            // Sync Synapse Tree telemetry
            document.getElementById('tree-tension').innerText = `${organicOrganism.membraneTension.toFixed(2)} kPa`;
            document.getElementById('tree-lumen').innerText = `${organicOrganism.bioluminescence.toFixed(1)} lumens`;

            // Render WebGL2 tissue + membrane canvas overlay
            if (renderer && scene && camera) {
                renderer.render(scene, camera);
                renderMembraneRippleOverlay(timeSec);
            }
        }

        // Tab Switching
        function switchTab(tab) {
            ['tissue', 'core', 'synapse'].forEach(t => {
                const btn = document.getElementById(`tab-${t}-btn`);
                const view = document.getElementById(`view-${t}`);
                btn.className = t === tab
                    ? 'px-2 py-1 rounded font-mono bg-emerald-500/30 text-emerald-100 border border-emerald-400 transition-all'
                    : 'px-2 py-1 rounded font-mono text-emerald-400/70 hover:text-emerald-200 transition-all';
                view.style.display = t === tab ? 'flex' : 'none';
            });
            if (tab === 'tissue') {
                setTimeout(onViewportResize, 20);
            }
        }

        window.onload = function () {
            initOrganicScreen();
            setTissueScale(1024);
            requestAnimationFrame(animateOrganicScreen);
        };
    </script>
