    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@400;600;800&family=Inter:wght@300;400;500;600&display=swap');

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
            background-color: #020617; font-family: 'Inter', sans-serif; color: #f8fafc;
            user-select: none; -webkit-user-select: none; touch-action: none;
        }

        .font-orbitron { font-family: 'Orbitron', sans-serif; }
        .font-mono-code { font-family: 'Fira Code', monospace; }

        .hardware-chassis {
            width: 100vw; height: 100dvh;
            border-radius: 0px; border: none; background: #020617; box-shadow: none;
        }
        @media (min-width: 640px) {
            .hardware-chassis {
                width: 480px; height: 920px; border-radius: 42px;
                border: 3px solid rgba(16, 185, 129, 0.45);
                box-shadow: 0 0 100px rgba(0, 0, 0, 0.99), 0 0 80px rgba(16, 185, 129, 0.25);
            }
        }

        .glass-panel {
            background: rgba(3, 15, 26, 0.92);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .organic-pill {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.22) 0%, rgba(4, 47, 46, 0.65) 100%);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(52, 211, 153, 0.55);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .organic-pill:active { transform: scale(0.95); }
        .organic-pill.active-pill {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.42) 0%, rgba(6, 95, 70, 0.85) 100%);
            border-color: rgba(110, 231, 183, 0.9);
            box-shadow: 0 0 18px rgba(16, 185, 129, 0.4);
        }

        .custom-scroll::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(52, 211, 153, 0.4); border-radius: 4px; }

        @keyframes organicPulse {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.03); }
        }
        .tissue-glow { animation: organicPulse 3.5s infinite ease-in-out; }
    </style>
</head>
