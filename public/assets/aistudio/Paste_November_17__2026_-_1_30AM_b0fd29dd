  <!-- Fused Master Operating System Controller Script -->
  <script>
    lucide.createIcons();

    // Clock ticker
    setInterval(() => {
      const clock = document.getElementById('top-clock');
      if (clock) clock.textContent = new Date().toTimeString().split(' ')[0].substring(0, 5);
    }, 1000);

    // --- App Window Management ---
    function openVideoEditor() {
      document.getElementById('video-editor-modal').style.display = 'flex';
      WorkstationApp.logEvent("APPS", "Launched Cometic Studio Pro Video Editor.");
    }
    function closeVideoEditor() {
      document.getElementById('video-editor-modal').style.display = 'none';
    }

    function openInternetBrowser() {
      document.getElementById('browser-modal').style.display = 'flex';
      WorkstationApp.logEvent("APPS", "Launched Aether-Net Browser.");
    }
    function closeInternetBrowser() {
      document.getElementById('browser-modal').style.display = 'none';
    }

    // --- Professional Video Editor Controller ---
    class VideoEditor {
      constructor() {
        this.isPlaying = false;
        this.currentTime = 0;
        this.duration = 15.0;
        this.timer = null;
        this.clips = [
          { id: 1, name: 'Sci-Fi Drone.mp4', type: 'video', duration: 8, start: 0 },
          { id: 2, name: 'Cyber Transition.mp4', type: 'video', duration: 7, start: 8 }
        ];
        this.renderTimeline();
      }

      togglePlay() {
        this.isPlaying = !this.isPlaying;
        const btn = document.getElementById('ve-play-btn');
        if (this.isPlaying) {
          btn.innerHTML = `<i data-lucide="pause" class="w-4 h-4"></i> Pause`;
          lucide.createIcons();
          this.timer = setInterval(() => {
            this.currentTime += 0.1;
            if (this.currentTime >= this.duration) {
              this.currentTime = 0;
              this.isPlaying = false;
              clearInterval(this.timer);
              btn.innerHTML = `<i data-lucide="play" class="w-4 h-4"></i> Play`;
              lucide.createIcons();
            }
            this.updatePlayheadUI();
          }, 100);
          WorkstationApp.logEvent("EDITOR", "Playback started.");
        } else {
          btn.innerHTML = `<i data-lucide="play" class="w-4 h-4"></i> Play`;
          lucide.createIcons();
          clearInterval(this.timer);
          WorkstationApp.logEvent("EDITOR", "Playback paused.");
        }
      }

      seekTo(time) {
        this.currentTime = time;
        this.updatePlayheadUI();
      }

      updatePlayheadUI() {
        const pct = (this.currentTime / this.duration) * 100;
        const playhead = document.getElementById('ve-playhead');
        if (playhead) playhead.style.left = `${pct}%`;
        const timecode = document.getElementById('ve-timecode');
        if (timecode) {
          const secs = Math.floor(this.currentTime);
          const ms = Math.floor((this.currentTime - secs) * 100);
          timecode.textContent = `00:00:${secs < 10 ? '0'+secs : secs}:${ms < 10 ? '0'+ms : ms}`;
        }
      }

      splitClip() {
        WorkstationApp.logEvent("EDITOR", `Split active clip at playhead position ${this.currentTime.toFixed(1)}s.`);
        WorkstationApp.appendRepl(`Video Editor: Split clip at ${this.currentTime.toFixed(1)}s`, 'emerald');
      }

      applyEffect(type, val) {
        const screen = document.getElementById('ve-preview-screen');
        if (!screen) return;
        if (val === 'cyberpunk') {
          screen.className = "w-full max-w-2xl aspect-video bg-gradient-to-br from-slate-950 via-rose-950 to-purple-950 rounded-lg border border-pink-400 relative flex items-center justify-center overflow-hidden shadow-2xl";
        } else if (val === 'matrix') {
          screen.className = "w-full max-w-2xl aspect-video bg-gradient-to-br from-slate-950 via-emerald-950 to-slate-900 rounded-lg border border-emerald-400 relative flex items-center justify-center overflow-hidden shadow-2xl";
        } else if (val === 'cinematic') {
          screen.className = "w-full max-w-2xl aspect-video bg-gradient-to-br from-slate-950 via-cyan-950 to-blue-950 rounded-lg border border-cyan-400 relative flex items-center justify-center overflow-hidden shadow-2xl";
        } else {
          screen.className = "w-full max-w-2xl aspect-video bg-slate-950 rounded-lg border border-slate-700 relative flex items-center justify-center overflow-hidden shadow-2xl";
        }
        WorkstationApp.logEvent("EDITOR", `Applied color grade LUT: ${val}`);
      }

      updateTitle(txt) {
        const titleEl = document.getElementById('ve-title-text');
        if (titleEl) titleEl.textContent = txt || "AIM-COMETIC PRO MOVIE";
      }

      addClip(name, type, dur) {
        this.clips.push({ id: Date.now(), name, type, duration: dur, start: this.duration });
        this.duration += dur;
        this.renderTimeline();
        WorkstationApp.logEvent("EDITOR", `Added ${name} to timeline.`);
      }

      renderTimeline() {
        const vTrack = document.getElementById('ve-track-video');
        const aTrack = document.getElementById('ve-track-audio');
        if (!vTrack || !aTrack) return;
        
        vTrack.innerHTML = '';
        aTrack.innerHTML = '';

        this.clips.forEach((clip, idx) => {
          const widthPct = (clip.duration / this.duration) * 100;
          if (clip.type === 'video') {
            const el = document.createElement('div');
            el.className = 'h-9 bg-rose-600/30 border border-rose-400/60 rounded px-2 flex items-center justify-between text-[10px] text-rose-200 font-mono overflow-hidden cursor-pointer';
            el.style.width = `${widthPct}%`;
            el.innerHTML = `<span>🎬 ${clip.name}</span><span class="opacity-60">${clip.duration}s</span>`;
            vTrack.appendChild(el);
          } else {
            const el = document.createElement('div');
            el.className = 'h-7 bg-indigo-600/30 border border-indigo-400/60 rounded px-2 flex items-center justify-between text-[10px] text-indigo-200 font-mono overflow-hidden cursor-pointer';
            el.style.width = `${widthPct}%`;
            el.innerHTML = `<span>🎵 ${clip.name}</span><span class="opacity-60">~||||~</span>`;
            aTrack.appendChild(el);
          }
        });
      }

      exportProject() {
        WorkstationApp.logEvent("EDITOR", "Rendering 4K H.265 Master via WebGL2 Hardware Encoder...");
        WorkstationApp.appendRepl("Video Editor: Exporting master file to OPFS scratch disk...", "cyan");
        setTimeout(() => {
          WorkstationApp.logEvent("EDITOR", "Export completed successfully! Saved to /opfs/exports/Master_Render.mp4");
          WorkstationApp.appendRepl("Video Editor: Export complete (/opfs/exports/Master_Render.mp4)", "emerald");
        }, 1500);
      }
    }

    let videoEditor;

    // --- Interactive Internet Browser Controller ---
    class InternetBrowser {
      constructor() {
        this.history = ['https://en.wikipedia.org/wiki/Main_Page'];
        this.currentIndex = 0;
      }

      navigateTo(url) {
        if (!url) return;
        let finalUrl = url.trim();
        if (!finalUrl.startsWith('http://') && !finalUrl.startsWith('https://')) {
          finalUrl = 'https://' + finalUrl;
        }
        document.getElementById('browser-url-input').value = finalUrl;
        document.getElementById('browser-iframe').src = finalUrl;
        this.history = this.history.slice(0, this.currentIndex + 1);
        this.history.push(finalUrl);
        this.currentIndex = this.history.length - 1;
        WorkstationApp.logEvent("BROWSER", `Navigated to ${finalUrl}`);
      }

      goBack() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          const url = this.history[this.currentIndex];
          document.getElementById('browser-url-input').value = url;
          document.getElementById('browser-iframe').src = url;
          WorkstationApp.logEvent("BROWSER", `Navigated back to ${url}`);
        }
      }

      goForward() {
        if (this.currentIndex < this.history.length - 1) {
          this.currentIndex++;
          const url = this.history[this.currentIndex];
          document.getElementById('browser-url-input').value = url;
          document.getElementById('browser-iframe').src = url;
          WorkstationApp.logEvent("BROWSER", `Navigated forward to ${url}`);
        }
      }

      reload() {
        const iframe = document.getElementById('browser-iframe');
        iframe.src = iframe.src;
        WorkstationApp.logEvent("BROWSER", "Reloaded active tab frame.");
      }

      addNewTab() {
        this.navigateTo('https://wikipedia.org');
        WorkstationApp.logEvent("BROWSER", "Opened new browser tab.");
      }
    }

    let internetBrowser;


    // --- Cometic Engine 3D Spatial Background Class ---
    class CometicEngine {
      constructor() {
        this.scene = null;
        this.camera = null;
        this.renderer = null;
        this.composer = null;
        this.bloomPass = null;
        this.gelShaderMat = null;
        this.coreMesh = null;
        this.particleSystem = null;
        this.wireframeGrid = null;
        
        this.currentStep = 1;
        this.unlockedSteps = { 1: true };
        this.clock = new THREE.Clock();
        
        this.stepDetails = {
          1: { title: "Soft Pastel WebGL2 Context", desc: "Boots hardware-accelerated context with warm twilight ambient lighting.", hook: () => {} },
          2: { title: "Squishy Gel Matrix Shader", desc: "Compiles custom vertex shaders featuring organic gelatinous wobble.", hook: () => { if(this.coreMesh) { this.coreMesh.scale.set(1.15,1.15,1.15); setTimeout(()=>this.coreMesh.scale.set(1,1,1), 400); } } },
          3: { title: "Dreamy Pastel Bloom Compositor", desc: "Applies high-pass UnrealBloom with a soft magenta tint.", hook: () => { if(this.bloomPass) { this.bloomPass.strength = 2.8; setTimeout(()=>this.bloomPass.strength=2.0, 900); } } },
          4: { title: "Bouncing Cute Data-Spirits", desc: "Spawns 800+ bouncy data-motes orbiting the core.", hook: () => {} },
          5: { title: "Harmonic Chime Freq Spectrum", desc: "Binds simulated audio frequencies to gentle scaling pulses.", hook: () => WorkstationApp.appendRepl("Audio harmonic frequencies pulsed.", "cyan") },
          6: { title: "Chibi Raymarched Hyper-Voxels", desc: "Introduces rounded pillowy signed distance field geometry primitives.", hook: () => { if(this.coreMesh) this.coreMesh.rotation.y += 0.6; } },
          7: { title: "Affectionate Gravity Singularity", desc: "Deforms space-time into a cozy gravitational vortex.", hook: () => { if(this.bloomPass) { this.bloomPass.radius = 0.95; setTimeout(()=>this.bloomPass.radius=0.6, 1100); } } },
          8: { title: "10,000 Autonomous Swarm Pets", desc: "Deploys companion AGI pets that maintain cheerful boid formations.", hook: WorkstationApp.logEvent("AGI", "10,000 Autonomous Swarm Pets online! (◕‿◕✿)") },
          9: { title: "Marshmallow Horizon Grid", desc: "Constructs an infinite glowing pastel wireframe floor.", hook: () => { if(this.wireframeGrid) this.wireframeGrid.material.opacity = 0.45; } },
          10: { title: "Full Cometic Core Synthesis", desc: "Unlocks ultimate Kawaii Kernel: maximum bloom radiance.", hook: () => { if(this.bloomPass) this.bloomPass.strength = 3.5; } }
        };
      }

      init() {
        const container = document.getElementById('viewport-container');
        const width = container.clientWidth;
        const height = container.clientHeight;

        this.scene = new THREE.Scene();
        this.scene.fog = new THREE.FogExp2(0x0b0f19, 0.012);

        this.camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
        this.camera.position.set(0, 4, 26);
        this.camera.lookAt(0, 0, 0);

        const canvas = document.getElementById('simCanvas');
        this.renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
        this.renderer.setSize(width, height);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
        this.renderer.toneMappingExposure = 1.3;

        const renderScene = new THREE.RenderPass(this.scene, this.camera);
        this.bloomPass = new THREE.UnrealBloomPass(new THREE.Vector2(width, height), 1.8, 0.5, 0.75);
        this.bloomPass.threshold = 0.08;
        this.bloomPass.strength = 2.0;
        this.bloomPass.radius = 0.6;

        this.composer = new THREE.EffectComposer(this.renderer);
        this.composer.addPass(renderScene);
        this.composer.addPass(this.bloomPass);

        this.scene.add(new THREE.AmbientLight(0xffb6c1, 2.2));
        const pointLight = new THREE.PointLight(0xf472b6, 6, 60);
        pointLight.position.set(0, 10, 8);
        this.scene.add(pointLight);

        this.buildCometicGeometry();

        window.addEventListener('resize', () => {
          const w = container.clientWidth;
          const h = container.clientHeight;
          this.camera.aspect = w / h;
          this.camera.updateProjectionMatrix();
          this.renderer.setSize(w, h);
          this.composer.setSize(w, h);
        });
      }

      buildCometicGeometry() {
        const vertexShader = `
          uniform float uTime;
          varying vec3 vNormal;
          varying vec2 vUv;
          void main() {
            vNormal = normal;
            vUv = uv;
            vec3 pos = position;
            float squish = sin(pos.x * 2.5 + uTime * 2.0) * cos(pos.y * 2.5 + uTime * 2.0) * 0.35;
            pos += normal * squish;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
          }
        `;
        const fragmentShader = `
          uniform float uTime;
          varying vec3 vNormal;
          varying vec2 vUv;
          void main() {
            vec3 pastelPink = vec3(0.95, 0.45, 0.70);
            vec3 pastelCyan = vec3(0.22, 0.74, 0.96);
            vec3 col = mix(pastelPink, pastelCyan, sin(vUv.x * 6.0 + uTime) * 0.5 + 0.5);
            float rim = 1.0 - max(dot(vNormal, vec3(0, 0, 1)), 0.0);
            col += vec3(1.0, 0.8, 0.9) * pow(rim, 2.5) * 1.8;
            gl_FragColor = vec4(col, 0.92);
          }
        `;

        this.gelShaderMat = new THREE.ShaderMaterial({
          vertexShader, fragmentShader,
          uniforms: { uTime: { value: 0.0 } },
          transparent: true, side: THREE.DoubleSide
        });

        this.coreMesh = new THREE.Mesh(new THREE.IcosahedronGeometry(4.2, 3), this.gelShaderMat);
        this.scene.add(this.coreMesh);

        const pGeo = new THREE.BufferGeometry();
        const pCount = 800;
        const positions = new Float32Array(pCount * 3);
        const velocities = new Float32Array(pCount * 3);
        for (let i = 0; i < pCount * 3; i += 3) {
          positions[i] = (Math.random() - 0.5) * 32;
          positions[i+1] = (Math.random() - 0.5) * 22;
          positions[i+2] = (Math.random() - 0.5) * 32;
          velocities[i] = (Math.random() - 0.5) * 0.04;
          velocities[i+1] = (Math.random() - 0.5) * 0.04 + 0.01;
          velocities[i+2] = (Math.random() - 0.5) * 0.04;
        }
        pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        this.particleSystem = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: 0xffaecd, size: 0.22, transparent: true, blending: THREE.AdditiveBlending }));
        this.particleSystem.userData = { velocities };
        this.scene.add(this.particleSystem);

        this.wireframeGrid = new THREE.Mesh(new THREE.PlaneGeometry(60, 60, 25, 25), new THREE.MeshBasicMaterial({ color: 0xf472b6, wireframe: true, transparent: true, opacity: 0.25 }));
        this.wireframeGrid.rotation.x = Math.PI / 2;
        this.wireframeGrid.position.y = -8;
        this.scene.add(this.wireframeGrid);
      }

      activateStep(stepNum) {
        if (stepNum > 10 || stepNum < 1) return;
        this.currentStep = stepNum;
        this.unlockedSteps[stepNum] = true;

        for (let i = 1; i <= 10; i++) {
          const card = document.getElementById(`step-card-${i}`);
          const statusSpan = document.getElementById(`s${i}-status`);
          if (card && statusSpan) {
            if (this.unlockedSteps[i]) {
              card.className = i === this.currentStep ? 'step-card active-step p-2 rounded-xl space-y-1 cursor-pointer' : 'step-card unlocked p-2 rounded-xl space-y-1 cursor-pointer';
              statusSpan.innerText = '♥';
            } else {
              card.className = 'step-card p-2 rounded-xl space-y-1 cursor-pointer opacity-60';
              statusSpan.innerText = '🔒';
            }
          }
        }
        const detail = this.stepDetails[stepNum];
        document.getElementById('step-detail-view').innerHTML = `
          <div class="text-pink-300 font-bold">STAGE ${stepNum}: ${detail.title}</div>
          <div class="text-slate-300 mt-1">${detail.desc}</div>
        `;
        document.getElementById('current-stage-label').innerText = `Step ${stepNum}`;
        WorkstationApp.logEvent("KAWAHI", `Activated Step ${stepNum}: ${detail.title}`);
        detail.hook();
      }

      triggerActiveStepAction() {
        if (this.stepDetails[this.currentStep]) {
          this.stepDetails[this.currentStep].hook();
          WorkstationApp.appendRepl(`Patted data-spirit at Stage ${this.currentStep}! (>^ω^<)`, "cyan");
        }
      }

      runFullEvolutionSequence() {
        let step = 1;
        const interval = setInterval(() => {
          this.activateStep(step);
          step++;
          if (step > 10) {
            clearInterval(interval);
            WorkstationApp.logEvent("OVERDRIVE", "10,000 AGI Swarm Pets cheering at maximum cuteness! (✨^▽^✨)");
          }
        }, 350);
      }

      update(delta, time) {
        if (this.gelShaderMat) this.gelShaderMat.uniforms.uTime.value = time;
        if (this.coreMesh) {
          this.coreMesh.rotation.x = time * 0.15;
          this.coreMesh.rotation.y = time * 0.25;
        }
        if (this.particleSystem) {
          const pos = this.particleSystem.geometry.attributes.position.array;
          const vel = this.particleSystem.userData.velocities;
          for (let i = 0; i < pos.length; i += 3) {
            pos[i] += vel[i]; pos[i+1] += vel[i+1]; pos[i+2] += vel[i+2];
            if (Math.abs(pos[i]) > 22) vel[i] *= -1;
            if (pos[i+1] > 15) pos[i+1] = -12;
            if (pos[i+1] < -15) pos[i+1] = 12;
            if (Math.abs(pos[i+2]) > 22) vel[i+2] *= -1;
          }
          this.particleSystem.geometry.attributes.position.needsUpdate = true;
          this.particleSystem.rotation.y = time * 0.04;
        }
        if (this.composer) this.composer.render();
      }
    }

    // --- AIM Workstation Controller ---
    const WorkstationApp = {
      cadShape: 'torus',

      logEvent(source, msg) {
        const time = new Date().toTimeString().split(' ')[0];
        const stream = document.getElementById('aetherfs-log-stream');
        if (!stream) return;
        const entry = document.createElement('div');
        entry.className = 'p-2 rounded bg-white/5 border border-white/5 space-y-0.5 animate-pulse';
        entry.innerHTML = `
          <div class="flex justify-between text-[9px] text-slate-400"><span>[${source}]</span><span>${time}</span></div>
          <p class="text-slate-200">${msg}</p>
        `;
        stream.prepend(entry);
        this.appendRepl(`[${source}] ${msg}`, 'cyan');
      },

      appendRepl(text, color = 'slate') {
        const out = document.getElementById('repl-terminal-output');
        if (!out) return;
        const line = document.createElement('div');
        line.className = color === 'cyan' ? 'text-cyan-400' : (color === 'emerald' ? 'text-emerald-400' : 'text-slate-300');
        line.textContent = text;
        out.appendChild(line);
        out.scrollTop = out.scrollHeight;
      },

      handleReplCommand(cmd) {
        if (!cmd) return;
        this.appendRepl(`$ ${cmd}`);
        document.getElementById('repl-input').value = '';
        const lower = cmd.trim().toLowerCase();

        if (lower === 'help') {
          this.appendRepl("Commands: 'editor', 'browser', 'overdrive', 'matrix', 'clear', 'stress', 'status', 'hug'");
        } else if (lower === 'editor') {
          openVideoEditor();
        } else if (lower === 'browser') {
          openInternetBrowser();
        } else if (lower === 'clear') {
          document.getElementById('repl-terminal-output').innerHTML = '';
        } else if (lower === 'stress') {
          this.triggerStressTest();
        } else if (lower === 'overdrive') {
          cometicEngine.runFullEvolutionSequence();
        } else if (lower === 'matrix') {
          toggleMatrixOverlay(true);
        } else if (lower === 'hug') {
          this.logEvent("KAWAHI", "Cometic vortex gave all OS systems a warm digital hug! ♡(˃ɷ˂)");
        } else {
          this.appendRepl(`Command not recognized: '${cmd}'. Type 'help'.`);
        }
      },

      triggerStressTest() {
        this.appendRepl("Initiating OPFS & WebGL2 Three.js stress test...", 'cyan');
        this.logEvent("STRESS", "Stress test engaged. Pushing 512MB blocks & parallel shaders.");
        setTimeout(() => {
          this.appendRepl("-> OPFS Peak: 198.4 MB/s (PASSED)", 'emerald');
          this.appendRepl("-> Three.js Frame Drop: 0 frames (PASSED)", 'emerald');
          this.logEvent("STRESS", "Stress test successfully completed.");
        }, 1200);
      },

      setCadShape(shape) {
        this.cadShape = shape;
        document.getElementById('cad-status-label').innerText = `PRIMITIVE: ${shape.toUpperCase()} | SDF Raymarching Active (0.001mm)`;
        this.logEvent("CAD", `Switched SDF primitive to: ${shape.toUpperCase()}`);
      },

      clearLogs() {
        document.getElementById('aetherfs-log-stream').innerHTML = '';
      }
    };

    let cometicEngine;

    function toggleMatrixOverlay(forceState) {
      const overlay = document.getElementById('matrix-overlay');
      const isOpen = forceState !== undefined ? forceState : overlay.style.display !== 'flex';
      overlay.style.display = isOpen ? 'flex' : 'none';
    }

    // Main Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      const delta = cometicEngine.clock.getDelta();
      const time = cometicEngine.clock.getElapsedTime();

      const fps = Math.round(1 / delta);
      document.getElementById('top-fps').innerText = `WebGL2: ${Math.min(fps, 120)} FPS`;

      cometicEngine.update(delta, time);
    }

    window.addEventListener('DOMContentLoaded', () => {
      cometicEngine = new CometicEngine();
      cometicEngine.init();
      cometicEngine.activateStep(1);
      
      videoEditor = new VideoEditor();
      internetBrowser = new InternetBrowser();

      requestAnimationFrame(animate);
    });
  </script>
