<!DOCTYPE html>
<html lang="en" class="h-full select-none bg-black">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AIM-Cometic OS v30.0 — Ultimate Fused Workstation & Cognitive Suite</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Three.js Postprocessing Addons -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Orbitron:wght@600;800&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            orbitron: ['Orbitron', 'sans-serif'],
            quicksand: ['Quicksand', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --glass-blur: 24px;
      --glass-bg: rgba(15, 23, 42, 0.88);
      --glass-bg-elevated: rgba(15, 23, 42, 0.95);
      --glass-border: rgba(244, 114, 182, 0.35);
      --glass-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.7);
      --text-primary: #f8fafc;
      --panel-inner: rgba(2, 6, 23, 0.8);
    }

    * { box-sizing: border-box; user-select: none; }
    input, textarea, pre, code, .selectable { user-select: text; }

    body {
      margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh;
      font-family: 'Inter', sans-serif; color: var(--text-primary); background-color: #0b0f19;
    }

    #viewport-container {
      position: absolute; inset: 0; z-index: 1; pointer-events: auto;
    }

    .glass-surface {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(180%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
    }
    .glass-bar {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(28px) saturate(190%);
      -webkit-backdrop-filter: blur(28px) saturate(190%);
      border-bottom: 1px solid var(--glass-border);
    }
    .glass-inner { background: var(--panel-inner); border: 1px solid rgba(255, 255, 255, 0.12); }

    .matrix-overlay, .app-modal {
      position: absolute; inset: 44px 16px 75px 16px;
      background: rgba(11, 15, 25, 0.94);
      backdrop-filter: blur(36px);
      -webkit-backdrop-filter: blur(36px);
      z-index: 600;
      display: none; flex-direction: column; padding: 16px; overflow: hidden;
      border: 1px solid rgba(244, 114, 182, 0.5);
      border-radius: 20px;
    }

    .step-card {
      background: rgba(30, 41, 59, 0.85);
      border: 1px solid rgba(244, 114, 182, 0.3);
      transition: all 0.2s ease;
    }
    .step-card.unlocked {
      border-color: rgba(244, 114, 182, 0.8);
      background: rgba(83, 29, 61, 0.35);
      box-shadow: 0 0 15px rgba(244, 114, 182, 0.25);
    }
    .step-card.active-step {
      border-color: #38bdf8;
      background: rgba(14, 116, 144, 0.4);
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
    }

    .glass-dock {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(32px) saturate(195%);
      -webkit-backdrop-filter: blur(32px) saturate(195%);
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(244, 114, 182, 0.4); border-radius: 9999px; }
  </style>
</head>
<body class="flex flex-col h-screen overflow-hidden">

  <!-- 3D Spatial WebGL2 / Cometic Engine Viewport Background -->
  <div id="viewport-container">
    <canvas id="simCanvas" class="w-full h-full block touch-none cursor-pointer"></canvas>
  </div>

  <!-- Micro-Fractal Top Status Bar -->
  <header class="glass-bar h-8 px-4 flex items-center justify-between z-[1000] text-xs font-medium shrink-0 relative">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <i data-lucide="sparkles" class="w-4 h-4 text-pink-400"></i>
        <span class="font-bold font-orbitron tracking-wider text-[11px] text-pink-300">AIM-COMETIC OS v30.0 ULTIMATE</span>
      </div>
      <span class="opacity-30">|</span>
      <div class="flex items-center gap-2 text-[11px] text-slate-300 font-mono">
        <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"></span>
        <span id="system-status-text">Spatial Matrix & 22 Subsystems Nominal</span>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-pink-500/20 border border-pink-400/30 text-[10px] text-pink-300 font-mono">
        <span>OPFS: 29.6%</span>
      </div>
      <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-[10px] text-emerald-300 font-mono">
        <span id="top-fps">WebGL2: 60 FPS</span>
      </div>
      <button id="top-clock" class="px-2 py-0.5 rounded hover:bg-white/15 transition font-mono tabular-nums text-xs">12:47</button>
    </div>
  </header>

  <!-- Main Multi-Window Workstation Workspace (Floats over 3D Engine) -->
  <main id="workstation-grid" class="flex-1 p-3 grid grid-cols-1 lg:grid-cols-12 gap-3 overflow-hidden relative z-[500] pointer-events-none">
    
    <!-- Left Column: OPFS Scratch Disk & AetherFS Sync Logger (Col 4) -->
    <div class="lg:col-span-4 flex flex-col gap-3 min-h-0 pointer-events-auto">
      
      <!-- Module 1: OPFS Scratch Disk Live Monitor -->
      <div class="glass-surface rounded-2xl p-4 flex flex-col gap-3 shrink-0 shadow-xl border border-pink-500/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-pink-400 to-purple-600 flex items-center justify-center shadow">
              <i data-lucide="hard-drive" class="w-4 h-4 text-slate-950"></i>
            </div>
            <h3 class="font-bold font-orbitron text-xs text-pink-300">OPFS Scratch Disk Monitor</h3>
          </div>
          <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-mono">Healthy</span>
        </div>
        <div class="space-y-2 font-mono text-xs">
          <div class="flex justify-between text-slate-300">
            <span>Quota Allocated:</span>
            <span class="text-pink-400 font-bold">14.8 GB / 50.0 GB</span>
          </div>
          <div class="w-full h-2.5 rounded-full bg-slate-900 border border-white/10 overflow-hidden relative">
            <div class="h-full bg-gradient-to-r from-pink-400 via-purple-500 to-cyan-400 transition-all duration-500" style="width: 29.6%"></div>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-1">
            <div class="p-2 rounded-xl glass-inner bg-slate-950/50">
              <div class="text-[10px] text-slate-400">Inode Health</div>
              <div class="text-sm font-bold text-emerald-300 font-orbitron mt-0.5">14,280 / 14k</div>
            </div>
            <div class="p-2 rounded-xl glass-inner bg-slate-950/50">
              <div class="text-[10px] text-slate-400">I/O Throughput</div>
              <div class="text-sm font-bold text-pink-300 font-orbitron mt-0.5">42.5 MB/s</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Module 5: AetherFS Sync Logger -->
      <div class="glass-surface rounded-2xl p-4 flex flex-col flex-1 min-h-0 shadow-xl border border-pink-500/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-2 shrink-0">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-indigo-500 to-pink-600 flex items-center justify-center shadow">
              <i data-lucide="folder-git-2" class="w-4 h-4 text-white"></i>
            </div>
            <h3 class="font-bold font-orbitron text-xs text-indigo-300">AetherFS Sync Logger</h3>
          </div>
          <button onclick="WorkstationApp.clearLogs()" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 text-[10px] text-slate-300 cursor-pointer">Clear</button>
        </div>
        <div id="aetherfs-log-stream" class="flex-1 overflow-y-auto space-y-1.5 font-mono text-[11px] pt-2">
          <div class="p-2 rounded bg-white/5 border border-white/5 space-y-0.5">
            <div class="flex justify-between text-[9px] text-slate-400"><span>[SYNC]</span><span>12:47:01</span></div>
            <p class="text-slate-200">Cometic spatial matrix journal checkpoint verified. Blake3 hash match.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Center Column: WebGL2 Compositor & Zero-Crossing CAD Kernel (Col 5) -->
    <div class="lg:col-span-5 flex flex-col gap-3 min-h-0 pointer-events-auto">
      
      <!-- Module 2: WebGL2 Video Rendering Pipeline Compositor -->
      <div class="glass-surface rounded-2xl p-4 flex flex-col gap-3 shrink-0 shadow-xl border border-pink-500/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-rose-500 to-purple-600 flex items-center justify-center shadow">
              <i data-lucide="clapperboard" class="w-4 h-4 text-white"></i>
            </div>
            <h3 class="font-bold font-orbitron text-xs text-rose-300">Cometic Shader & Bloom Compositor</h3>
          </div>
          <div class="flex items-center gap-2 font-mono text-[11px]">
            <span class="text-pink-400 font-bold" id="compositor-status">Active</span>
          </div>
        </div>
        <div class="relative w-full h-32 bg-slate-950/80 rounded-xl overflow-hidden border border-white/10 flex flex-col items-center justify-center p-3 text-center gap-2">
          <p class="text-xs text-pink-200 font-quicksand">✨ Three.js Spatial Engine rendering live backdrop. Launch apps below or use Kawaii Matrix.</p>
          <div class="flex items-center gap-2">
            <button onclick="openVideoEditor()" class="px-3 py-1.5 rounded-lg bg-rose-500/30 hover:bg-rose-500/50 text-rose-200 text-xs font-mono font-bold border border-rose-400/50 cursor-pointer flex items-center gap-1.5">
              <i data-lucide="video" class="w-3.5 h-3.5"></i> Launch Video Editor
            </button>
            <button onclick="openInternetBrowser()" class="px-3 py-1.5 rounded-lg bg-cyan-500/30 hover:bg-cyan-500/50 text-cyan-200 text-xs font-mono font-bold border border-cyan-400/50 cursor-pointer flex items-center gap-1.5">
              <i data-lucide="globe" class="w-3.5 h-3.5"></i> Launch Browser
            </button>
          </div>
        </div>
      </div>

      <!-- Module 3: Zero-Crossing CAD Kernel Signed Distance Field Viewport -->
      <div class="glass-surface rounded-2xl p-4 flex flex-col flex-1 min-h-0 shadow-xl border border-pink-500/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-2 shrink-0">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-400 to-teal-700 flex items-center justify-center shadow">
              <i data-lucide="box" class="w-4 h-4 text-white"></i>
            </div>
            <h3 class="font-bold font-orbitron text-xs text-emerald-300">Zero-Crossing CAD Kernel (SDF Viewport)</h3>
          </div>
          <div class="flex items-center gap-1.5 font-mono text-[10px]">
            <button onclick="WorkstationApp.setCadShape('torus')" class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 cursor-pointer">Torus</button>
            <button onclick="WorkstationApp.setCadShape('gyroid')" class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 cursor-pointer">Gyroid</button>
          </div>
        </div>
        <div class="flex-1 relative w-full bg-slate-950/80 rounded-xl overflow-hidden border border-white/10 flex items-center justify-center mt-2 p-3 text-center">
          <p class="text-xs text-emerald-300 font-mono" id="cad-status-label">PRIMITIVE: TORUS | SDF Raymarching Active (0.001mm)</p>
        </div>
      </div>

    </div>

    <!-- Right Column: Interactive REPL Terminal & Stress Test Control Deck (Col 3) -->
    <div class="lg:col-span-3 flex flex-col gap-3 min-h-0 pointer-events-auto">
      
      <!-- Module 4: Interactive REPL Terminal & Stress Test Deck -->
      <div class="glass-surface rounded-2xl p-4 flex flex-col flex-1 min-h-0 shadow-xl border border-pink-500/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-2 shrink-0">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow">
              <i data-lucide="terminal" class="w-4 h-4 text-white"></i>
            </div>
            <h3 class="font-bold font-orbitron text-xs text-amber-300">Interactive REPL & Kawaii Deck</h3>
          </div>
          <button onclick="WorkstationApp.triggerStressTest()" class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 font-bold font-mono text-[10px] cursor-pointer">Stress Test</button>
        </div>
        
        <!-- Terminal Output Area -->
        <div id="repl-terminal-output" class="flex-1 overflow-y-auto font-mono text-[11px] bg-slate-950/90 rounded-xl p-3 mt-2 border border-white/10 space-y-1.5 text-slate-300">
          <div class="text-pink-400">AIM-Cometic OS v30.0 Kernel Initialized. Type 'help', 'editor', 'browser'.</div>
          <div class="text-slate-500">$ sys.diagnostics --all</div>
          <div class="text-emerald-400">-> OPFS: 50GB allocated (OK)<br>-> WebGL2 Three.js: 60 FPS (OK)<br>-> AGI Swarm Pets: Online (✨^▽^✨)</div>
        </div>

        <!-- Terminal Command Input -->
        <div class="flex items-center gap-2 mt-2 shrink-0">
          <span class="text-amber-400 font-mono text-xs">$</span>
          <input type="text" id="repl-input" onkeydown="if(event.key==='Enter') WorkstationApp.handleReplCommand(this.value)" placeholder="Enter command ('editor', 'browser', 'help')..." class="flex-1 px-3 py-1.5 rounded-xl glass-inner bg-slate-950 text-xs text-slate-100 font-mono focus:outline-none">
          <button onclick="WorkstationApp.handleReplCommand(document.getElementById('repl-input').value)" class="px-3 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold font-mono text-xs cursor-pointer">Exec</button>
        </div>
      </div>

    </div>

  </main>

  <!-- PROFESSIONAL VIDEO EDITOR APP MODAL -->
  <div id="video-editor-modal" class="app-modal space-y-3 font-sans">
    <div class="flex items-center justify-between pb-2 border-b border-rose-500/30">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-rose-400 animate-pulse"></span>
        <span class="font-orbitron text-xs font-bold text-rose-300 tracking-wider">COMETIC STUDIO PRO // NON-LINEAR VIDEO EDITOR</span>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="videoEditor.exportProject()" class="bg-emerald-500/30 border border-emerald-400 text-emerald-200 px-3 py-1 rounded text-[10px] font-mono font-bold hover:bg-emerald-500/50 transition cursor-pointer flex items-center gap-1"><i data-lucide="download" class="w-3 h-3"></i> Export Video</button>
        <button onclick="closeVideoEditor()" class="text-slate-400 hover:text-white px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-[10px] font-mono cursor-pointer">CLOSE [X]</button>
      </div>
    </div>

    <!-- Editor Workspace: Preview + Inspector & Timeline -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 flex-1 min-h-0">
      <!-- Preview Screen & Controls (Col 8) -->
      <div class="lg:col-span-8 flex flex-col gap-3 min-h-0">
        <div class="flex-1 bg-black/90 rounded-xl border border-rose-500/30 relative flex flex-col items-center justify-center overflow-hidden p-4">
          <!-- Canvas for Video Preview Simulation -->
          <div id="ve-preview-screen" class="w-full max-w-2xl aspect-video bg-gradient-to-br from-slate-900 via-rose-950/40 to-slate-950 rounded-lg border border-rose-400/40 relative flex items-center justify-center overflow-hidden shadow-2xl">
            <!-- Simulated Active Visual Effect Layer -->
            <div id="ve-visual-overlay" class="absolute inset-0 flex items-center justify-center pointer-events-none transition-all duration-300">
              <h2 id="ve-title-text" class="font-orbitron font-bold text-xl text-pink-300 drop-shadow-[0_0_15px_rgba(244,114,182,0.8)]">AIM-COMETIC PRO MOVIE</h2>
            </div>
            <div class="absolute bottom-2 left-3 font-mono text-[10px] text-rose-300/80 bg-black/60 px-2 py-0.5 rounded">
              Timecode: <span id="ve-timecode">00:00:00</span> / 00:00:15
            </div>
          </div>
          <!-- Playback Controls -->
          <div class="flex items-center gap-3 mt-3">
            <button onclick="videoEditor.seekTo(0)" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-rose-300 cursor-pointer"><i data-lucide="skip-back" class="w-4 h-4"></i></button>
            <button onclick="videoEditor.togglePlay()" id="ve-play-btn" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold font-mono text-xs cursor-pointer flex items-center gap-1.5 shadow-lg"><i data-lucide="play" class="w-4 h-4"></i> Play</button>
            <button onclick="videoEditor.splitClip()" class="px-3 py-2 rounded-xl bg-purple-600/40 hover:bg-purple-600/60 text-purple-200 font-bold font-mono text-xs cursor-pointer border border-purple-400/40 flex items-center gap-1.5"><i data-lucide="scissors" class="w-4 h-4"></i> Split Clip</button>
          </div>
        </div>
      </div>

      <!-- Effects & Assets Panel (Col 4) -->
      <div class="lg:col-span-4 bg-slate-900/90 rounded-xl border border-rose-500/30 p-3 flex flex-col gap-3 font-mono text-xs overflow-y-auto">
        <div class="text-rose-300 font-bold pb-1 border-b border-rose-500/20 flex items-center gap-1.5"><i data-lucide="wand-2" class="w-4 h-4"></i> Video Effects & Filters</div>
        <div class="space-y-2">
          <label class="text-[10px] text-slate-400">Color Grade LUT</label>
          <select id="ve-lut-select" onchange="videoEditor.applyEffect('lut', this.value)" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-rose-200">
            <option value="cyberpunk">Cyberpunk Neon Pink</option>
            <option value="matrix">Matrix Emerald Grid</option>
            <option value="cinematic">Cinematic Teal & Orange</option>
            <option value="monochrome">Noir Monochrome</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="text-[10px] text-slate-400">Overlay Title Text</label>
          <input type="text" id="ve-title-input" value="AIM-COMETIC PRO MOVIE" oninput="videoEditor.updateTitle(this.value)" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-slate-100">
        </div>
        <div class="space-y-2 pt-2 border-t border-rose-500/20">
          <div class="text-[10px] text-slate-400 font-bold">Media Bin & Assets</div>
          <div class="grid grid-cols-2 gap-2">
            <div onclick="videoEditor.addClip('Video A (4K 60FPS)', 'video', 5)" class="p-2 rounded-lg bg-slate-950 border border-rose-500/20 hover:border-rose-400 cursor-pointer text-center">
              <i data-lucide="video" class="w-5 h-5 text-rose-400 mx-auto mb-1"></i>
              <span class="text-[10px] text-slate-200">Sci-Fi Drone.mp4</span>
            </div>
            <div onclick="videoEditor.addClip('Audio Synth Wave', 'audio', 8)" class="p-2 rounded-lg bg-slate-950 border border-indigo-500/20 hover:border-indigo-400 cursor-pointer text-center">
              <i data-lucide="music" class="w-5 h-5 text-indigo-400 mx-auto mb-1"></i>
              <span class="text-[10px] text-slate-200">SynthWave.wav</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline Multi-Track Area -->
    <div class="h-44 bg-slate-950/95 rounded-xl border border-rose-500/30 p-3 flex flex-col gap-2 overflow-hidden shrink-0">
      <div class="flex items-center justify-between text-[11px] font-mono pb-1 border-b border-white/10">
        <span class="text-rose-300 font-bold">// TIMELINE TRACKS (Video 1 & Audio 1)</span>
        <span class="text-slate-400">Duration: 15.0s</span>
      </div>
      <!-- Tracks Container -->
      <div id="ve-timeline-tracks" class="flex-1 overflow-x-auto space-y-2 relative pt-2">
        <!-- Playhead Indicator Line -->
        <div id="ve-playhead" class="absolute top-0 bottom-0 w-0.5 bg-yellow-400 z-20 pointer-events-none transition-all" style="left: 0px;"></div>
        
        <!-- Video Track 1 -->
        <div class="flex items-center gap-2">
          <span class="w-16 text-[10px] font-mono text-slate-400 font-bold">V1 Video</span>
          <div id="ve-track-video" class="flex-1 h-12 bg-slate-900 rounded-lg border border-rose-500/30 relative flex items-center px-2 gap-2 overflow-hidden">
            <!-- Dynamic clips inserted here -->
          </div>
        </div>
        <!-- Audio Track 1 -->
        <div class="flex items-center gap-2">
          <span class="w-16 text-[10px] font-mono text-slate-400 font-bold">A1 Audio</span>
          <div id="ve-track-audio" class="flex-1 h-10 bg-slate-900 rounded-lg border border-indigo-500/30 relative flex items-center px-2 gap-2 overflow-hidden">
