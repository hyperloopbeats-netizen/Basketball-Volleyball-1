    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@300;400;600&family=Orbitron:wght@400;600;800&family=Inter:wght@300;400;500;600&display=swap');

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
            background-color: #000000; font-family: 'Inter', sans-serif; color: #f1f5f9;
            user-select: none; -webkit-user-select: none; touch-action: none;
        }

        .font-orbitron { font-family: 'Orbitron', sans-serif; }
        .font-cinzel { font-family: 'Cinzel', serif; }

        /* Hardware Chassis Skeleton */
        .hardware-chassis {
            border-radius: 36px;
            border: 3px solid rgba(56, 189, 248, 0.35);
            box-shadow: 0 0 90px rgba(0, 0, 0, 0.99), 0 0 45px rgba(56, 189, 248, 0.25), inset 0 0 25px rgba(15, 23, 42, 0.9);
            background: #030712;
        }

        .perspective-container {
            perspective: 1500px;
            transform-style: preserve-3d;
        }

        /* Master UI Membrane Panels */
        .master-panel {
            background: rgba(4, 12, 24, 0.86);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(56, 189, 248, 0.35);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), inset 0 1px 3px rgba(255, 255, 255, 0.3);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            filter: blur(6px) brightness(0.65);
            opacity: 0.4;
            pointer-events: none;
            transform: scale(0.94) translateZ(-40px);
        }

        .master-panel.active-stimulus {
            filter: blur(0px) brightness(1.15);
            opacity: 1.0;
            pointer-events: auto;
            border-color: rgba(56, 189, 248, 0.9);
            box-shadow: 0 0 45px rgba(56, 189, 248, 0.45), inset 0 1px 4px rgba(255, 255, 255, 0.6);
            transform: scale(1.02) translateZ(25px);
        }

        /* Liquid Morphism Pill Buttons */
        .liquid-pill {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.25) 0%, rgba(14, 116, 144, 0.5) 100%);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(56, 189, 248, 0.6);
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.5);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .liquid-pill:hover {
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.8), inset 0 1px 3px rgba(255, 255, 255, 0.7);
            border-color: rgba(56, 189, 248, 1);
        }
        .liquid-pill:active { transform: scale(0.96); }

        .gooey-container { filter: url('#gooey-filter'); }

        /* Optical Vignette & Cinematic Widescreen Letterbox */
        .vignette {
            pointer-events: none;
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 50% 50%, transparent 22%, rgba(0, 0, 0, 0.97) 100%);
            z-index: 35;
        }

        .letterbox {
            position: absolute;
            left: 0; right: 0; height: 32px;
            background: #000000;
            z-index: 45;
            pointer-events: none;
        }
        .letterbox-top { top: 0; }
        .letterbox-bottom { bottom: 0; }

        .analog-scanlines {
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(56, 189, 248, 0.015) 50%, rgba(56, 189, 248, 0.015));
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 15;
        }

        .custom-scroll::-webkit-scrollbar { width: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.3); border-radius: 4px; }
    </style>
</head>
<body class="relative flex items-center justify-center w-full h-full bg-black p-0 sm:p-3">

