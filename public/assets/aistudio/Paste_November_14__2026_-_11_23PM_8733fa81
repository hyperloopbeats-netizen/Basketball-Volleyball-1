    function showToast(title, subtitle, accent = 'sky') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'glass-surface px-4 py-3 rounded-2xl shadow-xl flex items-start gap-3 w-72 transition-all duration-300 transform translate-x-4 opacity-0 pointer-events-auto';
