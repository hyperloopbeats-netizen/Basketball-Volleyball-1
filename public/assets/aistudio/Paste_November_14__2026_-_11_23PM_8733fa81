<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AIM OS Desktop v1.0.0 — Glassmorphic Tauri Environment</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
        }
      }
    }
  </script>
  <style>
    :root {
      --glass-blur: 24px;
      --glass-bg: rgba(255, 255, 255, 0.14);
      --glass-bg-elevated: rgba(255, 255, 255, 0.22);
      --glass-border: rgba(255, 255, 255, 0.28);
      --glass-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.45);
      --text-primary: #ffffff;
      --text-secondary: rgba(255, 255, 255, 0.72);
      --text-muted: rgba(255, 255, 255, 0.48);
      --accent-color: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.35);
      --panel-inner: rgba(15, 23, 42, 0.36);
    }

    body.light-glass {
      --glass-bg: rgba(255, 255, 255, 0.62);
      --glass-bg-elevated: rgba(255, 255, 255, 0.78);
      --glass-border: rgba(255, 255, 255, 0.85);
      --glass-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.18);
      --text-primary: #0f172a;
      --text-secondary: rgba(15, 23, 42, 0.75);
      --text-muted: rgba(15, 23, 42, 0.5);
      --panel-inner: rgba(255, 255, 255, 0.55);
    }

    * {
      box-sizing: border-box;
      user-select: none;
    }

    input, textarea, pre, code, .selectable {
      user-select: text;
    }

    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      font-family: 'Inter', sans-serif;
      color: var(--text-primary);
      transition: color 0.3s ease;
    }

    /* Atmospheric Wallpapers */
    .wallpaper-aurora {
      background:
        radial-gradient(at 15% 20%, rgba(56, 189, 248, 0.55) 0px, transparent 50%),
        radial-gradient(at 85% 15%, rgba(168, 85, 247, 0.52) 0px, transparent 52%),
        radial-gradient(at 75% 85%, rgba(236, 72, 153, 0.45) 0px, transparent 50%),
        radial-gradient(at 20% 80%, rgba(16, 185, 129, 0.42) 0px, transparent 50%),
        linear-gradient(135deg, #090d16 0%, #111827 50%, #0f172a 100%);
      background-size: 140% 140%;
      animation: meshShift 22s ease infinite alternate;
    }

    .wallpaper-glacier {
      background:
        radial-gradient(at 20% 25%, rgba(125, 211, 252, 0.75) 0px, transparent 55%),
        radial-gradient(at 80% 20%, rgba(196, 181, 253, 0.68) 0px, transparent 55%),
        radial-gradient(at 60% 85%, rgba(103, 232, 249, 0.65) 0px, transparent 55%),
        linear-gradient(135deg, #1e293b 0%, #334155 50%, #0f172a 100%);
      background-size: 140% 140%;
      animation: meshShift 26s ease infinite alternate;
    }

    .wallpaper-sunset {
      background:
        radial-gradient(at 18% 22%, rgba(251, 146, 60, 0.65) 0px, transparent 52%),
        radial-gradient(at 82% 28%, rgba(244, 63, 94, 0.6) 0px, transparent 55%),
        radial-gradient(at 45% 85%, rgba(139, 92, 246, 0.58) 0px, transparent 55%),
        linear-gradient(135deg, #181024 0%, #27132a 50%, #0f172a 100%);
      background-size: 140% 140%;
      animation: meshShift 24s ease infinite alternate;
    }

    .wallpaper-emerald {
      background:
        radial-gradient(at 20% 20%, rgba(52, 211, 153, 0.55) 0px, transparent 50%),
        radial-gradient(at 85% 30%, rgba(6, 182, 212, 0.5) 0px, transparent 52%),
        radial-gradient(at 50% 85%, rgba(59, 130, 246, 0.45) 0px, transparent 55%),
        linear-gradient(135deg, #061314 0%, #0b2226 50%, #09151e 100%);
      background-size: 140% 140%;
      animation: meshShift 20s ease infinite alternate;
    }

    @keyframes meshShift {
      0% { background-position: 0% 20%; }
      50% { background-position: 100% 60%; }
      100% { background-position: 25% 100%; }
    }

    /* Core Glassmorphism Surfaces */
    .glass-surface {
      background: var(--glass-bg);
      backdrop-filter: blur(var(--glass-blur)) saturate(175%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(175%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
    }

    .glass-bar {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(calc(var(--glass-blur) + 6px)) saturate(185%);
      -webkit-backdrop-filter: blur(calc(var(--glass-blur) + 6px)) saturate(185%);
      border-bottom: 1px solid var(--glass-border);
    }

    .glass-dock {
      background: var(--glass-bg-elevated);
      backdrop-filter: blur(calc(var(--glass-blur) + 8px)) saturate(190%);
      -webkit-backdrop-filter: blur(calc(var(--glass-blur) + 8px)) saturate(190%);
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    }

    .glass-inner {
      background: var(--panel-inner);
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .window-frame {
      transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .window-frame.dragging,
    .window-frame.resizing {
      transition: none !important;
    }

    .window-minimized {
      opacity: 0;
      transform: scale(0.86) translateY(60px);
      pointer-events: none;
    }

    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.24);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.4);
    }

    /* Dock Hover Magnification */
    .dock-item {
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), margin 0.22s ease;
    }
    .dock-item:hover {
      transform: translateY(-10px) scale(1.22);
      margin-left: 6px;
      margin-right: 6px;
    }

    /* Range Slider Styling */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.25);
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
      cursor: pointer;
    }
  </style>
</head>
<body class="wallpaper-aurora select-none">

  <!-- Brightness Overlay -->
  <div id="brightness-overlay" class="fixed inset-0 bg-black pointer-events-none z-[9998] transition-opacity duration-150" style="opacity: 0;"></div>

  <!-- Sleep / Lock Screen Overlay -->
  <div id="sleep-screen" class="fixed inset-0 z-[9999] hidden flex-col items-center justify-center backdrop-blur-3xl bg-slate-950/75 text-white transition-opacity duration-500">
    <div class="text-center space-y-4">
      <div id="lock-time" class="text-7xl font-light tracking-tight">18:04</div>
      <div id="lock-date" class="text-lg text-white/70 font-normal">Friday, November 13</div>
      <div class="pt-8">
        <button onclick="wakeSystem()" class="px-6 py-3 rounded-2xl glass-surface hover:bg-white/25 transition flex items-center gap-3 mx-auto text-sm font-medium shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
          Click to Unlock AIM OS
        </button>
      </div>
      <p class="text-xs text-white/40 font-mono pt-4">aim-os-desktop v1.0.0 • tauri v2 runtime suspended</p>
    </div>
  </div>

  <!-- Top Status Bar -->
  <header id="top-bar" class="glass-bar fixed top-0 left-0 right-0 h-9 px-3 sm:px-4 flex items-center justify-between z-[1000] text-xs font-medium">
    <!-- Left: System Menu + Active Window -->
    <div class="flex items-center gap-3">
      <div class="relative">
        <button id="apple-menu-btn" onclick="toggleMenu('system-menu')" class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/15 transition">
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span class="font-semibold tracking-tight">AIM OS</span>
        </button>

        <!-- System Dropdown -->
        <div id="system-menu" class="hidden absolute left-0 mt-2 w-60 rounded-2xl glass-surface p-1.5 shadow-2xl z-[1100] text-xs">
          <button onclick="openApp('about'); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex items-center justify-between">
            <span>About AIM OS Desktop</span>
            <span class="font-mono text-[10px] opacity-60">v1.0.0</span>
          </button>
          <div class="my-1 border-t border-white/15"></div>
          <button onclick="openApp('settings'); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15">System Preferences...</button>
          <button onclick="openApp('sysinfo'); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15">Task & Telemetry Monitor</button>
          <button onclick="openApp('terminal'); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15">Tauri Cargo Shell</button>
          <div class="my-1 border-t border-white/15"></div>
          <button onclick="sleepSystem(); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-white/15 flex items-center justify-between">
            <span>Sleep Runtime</span>
            <span class="opacity-50">⌥⌘S</span>
          </button>
          <button onclick="restartSystem(); closeMenus()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-rose-500/25 text-rose-300 flex items-center justify-between">
            <span>Restart Session</span>
            <span class="opacity-50">⌃⌘R</span>
          </button>
        </div>
      </div>

      <span class="opacity-30">|</span>
      <span id="active-app-label" class="font-semibold truncate max-w-[140px] sm:max-w-[220px]">Finder • Desktop</span>
      <div class="hidden md:flex items-center gap-3 ml-2 opacity-75">
        <button onclick="openApp('explorer')" class="hover:opacity-100 transition">File</button>
        <button onclick="openApp('notes')" class="hover:opacity-100 transition">Edit</button>
        <button onclick="toggleTheme()" class="hover:opacity-100 transition">View</button>
        <button onclick="openApp('about')" class="hover:opacity-100 transition">Crate Info</button>
      </div>
    </div>

    <!-- Right: Live sysinfo Telemetry + Control Center + Clock -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Live sysinfo Pill -->
      <button onclick="openApp('sysinfo')" title="Live sysinfo::System telemetry" class="hidden sm:flex items-center gap-2.5 px-2.5 py-0.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/15 transition font-mono text-[11px]">
        <span class="flex items-center gap-1 text-emerald-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          CPU <span id="top-cpu">18%</span>
        </span>
        <span class="opacity-30">•</span>
        <span class="text-sky-300">RAM <span id="top-ram">4.2G</span></span>
        <span class="hidden lg:inline opacity-30">•</span>
        <span class="hidden lg:inline text-purple-300">NET <span id="top-net">1.4MB/s</span></span>
      </button>

      <!-- Control Center Button -->
      <div class="relative">
        <button onclick="toggleMenu('control-center')" class="px-2 py-1 rounded-lg hover:bg-white/15 transition flex items-center gap-1.5" title="Control Center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          <span class="hidden md:inline">Control</span>
        </button>

        <!-- Control Center Popover -->
        <div id="control-center" class="hidden absolute right-0 mt-2 w-80 rounded-3xl glass-surface p-4 shadow-2xl z-[1100] space-y-3.5">
          <div class="grid grid-cols-2 gap-2.5">
            <button id="cc-wifi" onclick="toggleControl('wifi')" class="p-3 rounded-2xl bg-sky-500/30 border border-sky-400/40 flex items-center gap-3 text-left transition">
              <div class="w-8 h-8 rounded-full bg-sky-400 text-slate-950 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>
              </div>
              <div>
                <div class="text-xs font-semibold">Wi-Fi</div>
                <div id="cc-wifi-status" class="text-[10px] opacity-75">AIM-Fiber-6E</div>
              </div>
            </button>

            <button id="cc-bt" onclick="toggleControl('bt')" class="p-3 rounded-2xl bg-indigo-500/30 border border-indigo-400/40 flex items-center gap-3 text-left transition">
              <div class="w-8 h-8 rounded-full bg-indigo-400 text-slate-950 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m7 7 10 10-5 5V2l5 5L7 17"/></svg>
              </div>
              <div>
                <div class="text-xs font-semibold">Bluetooth</div>
                <div id="cc-bt-status" class="text-[10px] opacity-75">Active</div>
              </div>
            </button>
          </div>

          <!-- Theme & Glass Mode -->
          <div class="p-3 rounded-2xl glass-inner flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold">Frosted Glass Mode</div>
              <div id="theme-mode-label" class="text-[10px] opacity-70">Dark Obsidian Frost</div>
            </div>
            <button onclick="toggleTheme()" class="px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 text-xs font-medium transition">
              Switch Theme
            </button>
          </div>

          <!-- Brightness -->
          <div class="p-3 rounded-2xl glass-inner space-y-1.5">
            <div class="flex justify-between text-[11px]">
              <span class="opacity-80">Display Brightness</span>
              <span id="brightness-val" class="font-mono">100%</span>
            </div>
            <input type="range" min="35" max="100" value="100" oninput="setBrightness(this.value)" class="w-full" />
          </div>

          <!-- Volume -->
          <div class="p-3 rounded-2xl glass-inner space-y-1.5">
            <div class="flex justify-between text-[11px]">
              <span class="opacity-80">System Audio</span>
              <span id="volume-val" class="font-mono">76%</span>
            </div>
            <input type="range" min="0" max="100" value="76" oninput="document.getElementById('volume-val').textContent = this.value + '%'" class="w-full" />
          </div>

          <!-- Quick Wallpaper Switcher -->
          <div class="space-y-1.5">
            <div class="text-[11px] opacity-75 px-1">Atmospheric Wallpaper</div>
            <div class="grid grid-cols-4 gap-2">
              <button onclick="setWallpaper('aurora')" class="h-8 rounded-xl wallpaper-aurora border border-white/40 hover:scale-105 transition" title="Aurora Mesh"></button>
              <button onclick="setWallpaper('glacier')" class="h-8 rounded-xl wallpaper-glacier border border-white/40 hover:scale-105 transition" title="Nordic Glacier"></button>
              <button onclick="setWallpaper('sunset')" class="h-8 rounded-xl wallpaper-sunset border border-white/40 hover:scale-105 transition" title="Solar Dusk"></button>
              <button onclick="setWallpaper('emerald')" class="h-8 rounded-xl wallpaper-emerald border border-white/40 hover:scale-105 transition" title="Emerald Matrix"></button>
            </div>
          </div>
        </div>
      </div>

      <!-- Chrono Clock & Calendar Popover -->
      <div class="relative">
        <button onclick="toggleMenu('calendar-popover')" id="top-clock" class="px-2 py-1 rounded-lg hover:bg-white/15 transition font-medium tabular-nums">
          Fri Nov 13 • 6:04 PM
        </button>

        <div id="calendar-popover" class="hidden absolute right-0 mt-2 w-72 rounded-3xl glass-surface p-4 shadow-2xl z-[1100] space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <div id="cal-month" class="text-sm font-semibold">November 2026</div>
              <div class="text-[10px] font-mono opacity-65">chrono::Local::now()</div>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-sky-400/20 text-sky-300 font-mono text-[10px]">UTC-07:00</span>
          </div>
          <div id="calendar-grid" class="grid grid-cols-7 gap-1 text-center text-[11px]"></div>
          <div class="pt-2 border-t border-white/15 text-[11px] flex items-center justify-between opacity-80">
            <span>Uptime (sysinfo)</span>
            <span id="uptime-counter" class="font-mono">00:00:14</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Desktop Area -->
  <main id="desktop-area" oncontextmenu="showDesktopContextMenu(event)" class="relative w-full h-full pt-12 pb-24 px-4 overflow-hidden">

    <!-- Desktop Shortcuts Grid -->
    <div id="desktop-icons" class="grid grid-flow-col grid-rows-5 gap-3 w-fit">
      <button ondblclick="openApp('explorer')" onclick="selectDesktopIcon(this)" class="desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 focus:bg-white/20 transition flex flex-col items-center gap-1.5 text-center">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">Projects & FS</span>
      </button>

      <button ondblclick="openApp('sysinfo')" onclick="selectDesktopIcon(this)" class="desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 focus:bg-white/20 transition flex flex-col items-center gap-1.5 text-center">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">sysinfo Monitor</span>
      </button>

      <button ondblclick="openApp('sqlite')" onclick="selectDesktopIcon(this)" class="desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 focus:bg-white/20 transition flex flex-col items-center gap-1.5 text-center">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">SQLite Studio</span>
      </button>

      <button ondblclick="openApp('terminal')" onclick="selectDesktopIcon(this)" class="desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 focus:bg-white/20 transition flex flex-col items-center gap-1.5 text-center">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-950 border border-white/25 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">Cargo Shell</span>
      </button>

      <button ondblclick="openApp('reqwest')" onclick="selectDesktopIcon(this)" class="desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 focus:bg-white/20 transition flex flex-col items-center gap-1.5 text-center">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">Reqwest Stream</span>
      </button>
    </div>

    <!-- Floating Desktop Crate Badge Widget (Top Right) -->
    <div class="hidden xl:block absolute top-14 right-6 w-72 rounded-3xl glass-surface p-4 space-y-3 pointer-events-auto">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-semibold tracking-wide uppercase opacity-80">aim_os_lib Runtime</span>
        </div>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-white/15">v1.0.0</span>
      </div>
      <p class="text-xs opacity-75 leading-relaxed">
        Tauri v2 glassmorphic shell powered by <span class="font-mono text-sky-300">tokio</span> async runtime, <span class="font-mono text-amber-300">rusqlite</span>, and <span class="font-mono text-emerald-300">notify</span> watchers.
      </p>
      <div class="flex gap-2">
        <button onclick="openApp('terminal')" class="flex-1 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-medium transition">Cargo Build</button>
