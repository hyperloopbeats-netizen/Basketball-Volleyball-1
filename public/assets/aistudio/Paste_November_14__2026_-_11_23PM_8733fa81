    function updateClock() {
      const now = new Date();
      const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const dayName = days[now.getDay()];
      const monthName = months[now.getMonth()];
      const dateNum = now.getDate();

      let hours = now.getHours();
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';
      const hours12 = hours % 12 || 12;

      document.getElementById('top-clock').textContent = `${dayName} ${monthName} ${dateNum} • ${hours12}:${minutes} ${ampm}`;
      document.getElementById('lock-time').textContent = `${String(hours).padStart(2, '0')}:${minutes}`;
      document.getElementById('lock-date').textContent = now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
    }
    setInterval(updateClock, 1000);

    function renderCalendar() {
      const now = new Date();
      const grid = document.getElementById('calendar-grid');
      const headers = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
      let html = headers.map(h => `<div class="opacity-50 font-semibold py-1">${h}</div>`).join('');
      const firstDay = new Date(now.getFullYear(), now.getMonth(), 1).getDay();
      const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
      for (let i = 0; i < firstDay; i++) html += `<div></div>`;
      for (let d = 1; d <= daysInMonth; d++) {
        const isToday = d === now.getDate();
        html += `<div class="py-1 rounded-lg ${isToday ? 'bg-sky-400 text-slate-950 font-bold' : 'hover:bg-white/15'}">${d}</div>`;
      }
      grid.innerHTML = html;
    }

    function startTelemetryLoop() {
      setInterval(() => {
        telemetry.uptimeSeconds++;
        const hrs = String(Math.floor(telemetry.uptimeSeconds / 3600)).padStart(2, '0');
        const mins = String(Math.floor((telemetry.uptimeSeconds % 3600) / 60)).padStart(2, '0');
        const secs = String(telemetry.uptimeSeconds % 60).padStart(2, '0');
        const uptimeEl = document.getElementById('uptime-counter');
        if (uptimeEl) uptimeEl.textContent = `${hrs}:${mins}:${secs}`;

        // Update CPU cores & average
        telemetry.cores = telemetry.cores.map(c => {
          const delta = Math.floor(Math.random() * 13) - 6;
          return Math.max(4, Math.min(94, c + delta));
        });
        const avgCpu = Math.round(telemetry.cores.reduce((a, b) => a + b, 0) / telemetry.cores.length);
        telemetry.cpuHistory.push(avgCpu);
        telemetry.cpuHistory.shift();

        telemetry.ramUsedGB = +(Math.max(3.8, Math.min(11.4, telemetry.ramUsedGB + (Math.random() * 0.16 - 0.08)))).toFixed(1);
        telemetry.netDown = +(Math.max(0.2, Math.random() * 4.8)).toFixed(1);
        telemetry.netUp = +(Math.max(0.1, Math.random() * 1.4)).toFixed(2);

        document.getElementById('top-cpu').textContent = `${avgCpu}%`;
        document.getElementById('top-ram').textContent = `${telemetry.ramUsedGB}G`;
        document.getElementById('top-net').textContent = `${telemetry.netDown}MB/s`;

        if (openWindows['sysinfo'] && !openWindows['sysinfo'].minimized) {
