      showToast('notify::EventKind::Create', newPath, 'emerald');
    }

    // --- APP 3: SQLITE STUDIO (`rusqlite 0.31` / `tauri-plugin-sql`) ---
    function renderSqliteApp() {
      const tables = Object.keys(sqliteDB);
      const rows = sqliteDB[currentSqlTable] || [];
      const columns = rows.length > 0 ? Object.keys(rows[0]) : [];

      return `
        <div class="h-full flex flex-col gap-3">
          <!-- Top Bar -->
          <div class="flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-2xl glass-inner">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-lg bg-amber-400/20 text-amber-300 font-mono text-[11px]">sqlite:aim_os_store.db</span>
              <span class="opacity-70 text-[11px]">rusqlite::Connection (bundled)</span>
            </div>
            <div class="flex gap-1.5">
              ${tables.map(t => `
                <button onclick="switchSqlTable('${t}')" class="px-3 py-1 rounded-xl font-mono text-[11px] transition ${currentSqlTable === t ? 'bg-amber-400/30 border border-amber-300/50 font-semibold' : 'bg-white/10 hover:bg-white/20'}">
                  ${t}
                </button>
              `).join('')}
            </div>
          </div>

          <!-- SQL Query Bar -->
          <div class="flex gap-2">
            <input id="sql-query-input" type="text" value="SELECT * FROM ${currentSqlTable} LIMIT 50;" class="flex-1 px-3 py-2 rounded-xl glass-inner font-mono text-xs outline-none" />
            <button onclick="executeSimulatedSql()" class="px-4 py-2 rounded-xl bg-amber-500/35 hover:bg-amber-500/50 border border-amber-400/40 font-semibold transition">Run Query</button>
            <button onclick="insertSampleSqlRow()" class="px-3 py-2 rounded-xl bg-emerald-500/30 hover:bg-emerald-500/45 border border-emerald-400/40 font-medium transition">+ Insert Row</button>
          </div>

          <!-- Results Table -->
          <div class="flex-1 rounded-2xl glass-inner overflow-auto">
            <table class="w-full text-left border-collapse font-mono text-[11px]">
              <thead>
                <tr class="border-b border-white/15 bg-white/5">
                  ${columns.map(col => `<th class="p-2.5 font-semibold text-amber-200">${col}</th>`).join('')}
                </tr>
              </thead>
              <tbody>
                ${rows.map(row => `
                  <tr class="border-b border-white/10 hover:bg-white/10 transition">
                    ${columns.map(col => `<td class="p-2.5">${row[col]}</td>`).join('')}
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function switchSqlTable(tableName) {
      currentSqlTable = tableName;
      document.getElementById('win-body-sqlite').innerHTML = renderSqliteApp();
    }

    function executeSimulatedSql() {
      const q = document.getElementById('sql-query-input').value.trim();
      const lower = q.toLowerCase();
      if (lower.includes('system_logs')) currentSqlTable = 'system_logs';
      else if (lower.includes('app_configs')) currentSqlTable = 'app_configs';
      else if (lower.includes('users')) currentSqlTable = 'users';

      document.getElementById('win-body-sqlite').innerHTML = renderSqliteApp();
      document.getElementById('sql-query-input').value = q;
      showToast('rusqlite Query Executed', `Returned ${sqliteDB[currentSqlTable].length} rows in 0.4ms`, 'amber');
    }

    function insertSampleSqlRow() {
      const nowIso = new Date().toISOString();
      if (currentSqlTable === 'users') {
        const nextId = sqliteDB.users.length + 1;
        sqliteDB.users.push({ id: nextId, username: `guest_dev_${nextId}`, role: 'sandbox_user', created_at: nowIso });
      } else if (currentSqlTable === 'system_logs') {
        const nextId = 101 + sqliteDB.system_logs.length;
        sqliteDB.system_logs.push({ id: nextId, level: 'INFO', crate: 'tauri-plugin-sql', message: 'Committed transaction via rusqlite' });
      } else {
        sqliteDB.app_configs.push({ key: `custom.flag_${sqliteDB.app_configs.length + 1}`, value: 'true', updated_by: 'aim_admin' });
      }
      document.getElementById('win-body-sqlite').innerHTML = renderSqliteApp();
      showToast('SQLite Row Inserted', `INSERT INTO ${currentSqlTable} committed.`, 'emerald');
    }

    // --- APP 4: CARGO TERMINAL (`tauri v2` + `tokio`) ---
    function renderTerminalApp() {
      return `
        <div class="h-full flex flex-col rounded-2xl bg-slate-950/75 border border-white/15 p-3 font-mono text-xs text-slate-100">
          <div id="terminal-output" class="flex-1 overflow-y-auto space-y-1.5 leading-relaxed selectable">
            <div class="text-sky-400 font-semibold">AIM OS Desktop Shell v1.0.0 — Tauri v2 + Tokio Async Runtime</div>
            <div class="text-slate-400">Type <span class="text-emerald-300">help</span>, <span class="text-emerald-300">cargo build</span>, <span class="text-emerald-300">neofetch</span>, <span class="text-emerald-300">sysinfo</span>, or <span class="text-emerald-300">cat Cargo.toml</span>.</div>
          </div>
          <form onsubmit="handleTerminalSubmit(event)" class="pt-2 mt-2 border-t border-white/10 flex items-center gap-2">
            <span class="text-emerald-400 font-semibold">aim@desktop:~/aim-os-desktop$</span>
            <input id="terminal-input" type="text" autocomplete="off" spellcheck="false" placeholder="Enter command..." class="flex-1 bg-transparent border-none outline-none text-white font-mono text-xs" />
          </form>
        </div>
      `;
    }

    function appendTermLine(html) {
      const out = document.getElementById('terminal-output');
      if (!out) return;
      const div = document.createElement('div');
      div.innerHTML = html;
      out.appendChild(div);
      out.scrollTop = out.scrollHeight;
    }

    function handleTerminalSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('terminal-input');
      const raw = input.value.trim();
      if (!raw) return;
      input.value = '';

      appendTermLine(`<span class="text-emerald-400">aim@desktop:~/aim-os-desktop$</span> <span class="text-white">${raw}</span>`);
      const cmd = raw.toLowerCase();

      if (cmd === 'clear') {
        document.getElementById('terminal-output').innerHTML = '';
        return;
      }

      if (cmd === 'help') {
        appendTermLine(`<div class="text-slate-300 py-1">Available commands:<br/>
          • <span class="text-sky-300">cargo check</span> — Verify aim_os_lib crate dependencies<br/>
          • <span class="text-sky-300">cargo build</span> — Compile tauri v2 & bundled rusqlite target<br/>
          • <span class="text-sky-300">neofetch</span> — Display AIM OS system & crate summary<br/>
          • <span class="text-sky-300">sysinfo</span> — Print live CPU & RAM metrics<br/>
          • <span class="text-sky-300">ls</span> — List workspace files<br/>
          • <span class="text-sky-300">cat Cargo.toml</span> — Inspect manifest<br/>
          • <span class="text-sky-300">clear</span> — Clear terminal buffer</div>`);
      } else if (cmd === 'ls') {
        appendTermLine(`<span class="text-sky-300">Cargo.toml</span>  <span class="text-sky-300">tauri.conf.json</span>  <span class="text-emerald-300">src/</span>  <span class="text-amber-300">aim_os_store.sqlite</span>`);
      } else if (cmd === 'cat cargo.toml') {
        appendTermLine(`<pre class="text-slate-300 text-[11px] bg-white/5 p-2 rounded-xl my-1">${CARGO_TOML_TEXT}</pre>`);
      } else if (cmd === 'sysinfo') {
        const avgCpu = telemetry.cpuHistory[telemetry.cpuHistory.length - 1];
        appendTermLine(`<span class="text-emerald-300">[sysinfo 0.30]</span> CPU Load: ${avgCpu}% | RAM: ${telemetry.ramUsedGB} GB / 16.0 GB | Uptime: ${telemetry.uptimeSeconds}s`);
      } else if (cmd === 'neofetch') {
        appendTermLine(`<div class="p-2 rounded-xl bg-white/5 my-1 text-[11px] leading-snug">
          <span class="text-sky-400 font-bold">aim@aim-os-desktop</span><br/>
          -----------------------<br/>
          <span class="text-sky-300">OS:</span> AIM OS Desktop v1.0.0 (Glassmorphic Shell)<br/>
          <span class="text-sky-300">Crate:</span> aim_os_lib (staticlib, cdylib, rlib)<br/>
          <span class="text-sky-300">Runtime:</span> tauri v2 + tokio 1.0 (full)<br/>
          <span class="text-sky-300">Database:</span> rusqlite 0.31 (bundled) + tauri-plugin-sql<br/>
          <span class="text-sky-300">Telemetry:</span> sysinfo 0.30 + chrono 0.4<br/>
          <span class="text-sky-300">Watchers:</span> notify 6.1 + globset 0.4
        </div>`);
      } else if (cmd === 'cargo check' || cmd === 'cargo build') {
        const steps = [
          `<span class="text-emerald-400 font-semibold">   Compiling</span> serde v1.0.214`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> tokio v1.41.0 (full)`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> rusqlite v0.31.0 (bundled)`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> reqwest v0.11.27 (json, stream)`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> sysinfo v0.30.13`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> notify v6.1.1 & globset v0.4.15`,
          `<span class="text-emerald-400 font-semibold">   Compiling</span> aim-os-desktop v1.0.0 (/Users/aim/aim-os-desktop)`,
          `<span class="text-sky-400 font-semibold">    Finished</span> \`dev\` profile [unoptimized + debuginfo] target(s) in 1.42s`
        ];
        steps.forEach((step, idx) => {
          setTimeout(() => appendTermLine(step), idx * 180);
        });
      } else {
        appendTermLine(`<span class="text-rose-400">zsh: command not found:</span> ${raw} (try <span class="text-sky-300">help</span>)`);
      }
    }

    // --- APP 5: API & STREAM CLIENT (`reqwest 0.11` + `futures-util` + `serde_json`) ---
    function renderReqwestApp() {
      return `
        <div class="h-full flex flex-col gap-3">
          <div class="flex flex-wrap gap-2">
            <select id="reqwest-method" class="px-3 py-2 rounded-xl glass-inner font-mono text-xs font-semibold text-emerald-300 outline-none">
              <option value="GET">GET</option>
              <option value="STREAM">STREAM</option>
              <option value="POST">POST</option>
            </select>
            <input id="reqwest-url" type="text" value="https://api.aim-os.local/v1/telemetry/stream" class="flex-1 min-w-[200px] px-3 py-2 rounded-xl glass-inner font-mono text-xs outline-none" />
            <button onclick="sendReqwestCall()" class="px-4 py-2 rounded-xl bg-purple-500/40 hover:bg-purple-500/55 border border-purple-400/40 font-semibold transition">Send Async</button>
          </div>

          <!-- Preset Endpoints -->
          <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
            <span class="opacity-65">Presets:</span>
            <button onclick="setReqwestPreset('GET', 'https://api.aim-os.local/v1/sysinfo/snapshot')" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 font-mono">/sysinfo/snapshot</button>
            <button onclick="setReqwestPreset('STREAM', 'https://api.aim-os.local/v1/tokio/chunks')" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 font-mono">/tokio/chunks (stream)</button>
            <button onclick="setReqwestPreset('GET', 'https://api.aim-os.local/v1/crates/manifest')" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 font-mono">/crates/manifest</button>
          </div>

          <!-- Status Metrics -->
          <div class="flex items-center justify-between px-3 py-2 rounded-xl glass-inner font-mono text-[11px]">
            <span id="reqwest-status" class="text-emerald-300">Status: 200 OK (serde_json)</span>
            <span id="reqwest-latency" class="opacity-75">Latency: 14ms • futures_util::StreamExt</span>
          </div>

          <!-- JSON Output -->
          <pre id="reqwest-body" class="flex-1 p-3.5 rounded-2xl glass-inner font-mono text-[11px] leading-relaxed overflow-auto text-sky-200 selectable">{
  "crate": "aim_os_lib",
  "version": "1.0.0",
  "client": "reqwest 0.11 (json, stream)",
  "tokio_runtime": "multi_thread",
  "payload": {
    "status": "ready",
    "message": "Click Send Async or select a stream preset"
  }
}</pre>
        </div>
      `;
    }

    function setReqwestPreset(method, url) {
      document.getElementById('reqwest-method').value = method;
      document.getElementById('reqwest-url').value = url;
      sendReqwestCall();
    }

    function sendReqwestCall() {
      const method = document.getElementById('reqwest-method').value;
      const url = document.getElementById('reqwest-url').value;
      const bodyEl = document.getElementById('reqwest-body');
      const statusEl = document.getElementById('reqwest-status');
      const latencyEl = document.getElementById('reqwest-latency');

      if (method === 'STREAM' || url.includes('stream') || url.includes('chunks')) {
        statusEl.textContent = 'Status: 206 Partial Content (Streaming chunks...)';
        bodyEl.textContent = '// Opening reqwest::Response::bytes_stream() via futures_util...\n';
        let chunk = 1;
        const interval = setInterval(() => {
          if (!document.getElementById('reqwest-body')) {
            clearInterval(interval);
            return;
          }
          const line = JSON.stringify({
            chunk_id: chunk,
            timestamp: new Date().toISOString(),
            cpu_avg: telemetry.cpuHistory[telemetry.cpuHistory.length - 1],
            ram_gb: telemetry.ramUsedGB
          });
          bodyEl.textContent += line + '\n';
          bodyEl.scrollTop = bodyEl.scrollHeight;
          chunk++;
          if (chunk > 5) {
            clearInterval(interval);
            statusEl.textContent = 'Status: 200 OK (Stream Completed • 5 chunks)';
            latencyEl.textContent = 'Duration: 610ms • tokio::spawn';
          }
        }, 140);
      } else {
        const ms = Math.floor(8 + Math.random() * 24);
        statusEl.textContent = 'Status: 200 OK (application/json)';
        latencyEl.textContent = `Latency: ${ms}ms • serde_json::to_string_pretty`;
        const responseObj = {
          endpoint: url,
          method,
          timestamp_chrono: new Date().toISOString(),
          sysinfo_snapshot: {
            cpu_cores: telemetry.cores,
            memory_used_gb: telemetry.ramUsedGB,
            uptime_seconds: telemetry.uptimeSeconds
          },
          dependencies_loaded: 12
        };
        bodyEl.textContent = JSON.stringify(responseObj, null, 2);
      }
    }

    // --- APP 6: SCRATCHPAD (`serde` + `chrono`) ---
    function renderNotesApp() {
      return `
        <div class="h-full flex flex-col gap-2.5">
          <div class="flex items-center justify-between px-3 py-1.5 rounded-xl glass-inner text-[11px]">
            <span class="font-medium">notes.md — Auto-saved in memory</span>
            <span id="notes-saved-at" class="font-mono opacity-65">chrono::Local synced</span>
          </div>
          <textarea oninput="saveScratchpad(this.value)" class="flex-1 w-full p-4 rounded-2xl glass-inner font-mono text-xs leading-relaxed outline-none resize-none selectable">${scratchpadContent}</textarea>
        </div>
      `;
    }

    function saveScratchpad(val) {
      scratchpadContent = val;
      const el = document.getElementById('notes-saved-at');
      if (el) el.textContent = `Saved ${new Date().toTimeString().split(' ')[0]}`;
    }

    // --- APP 7: GLASS SETTINGS ---
    function renderSettingsApp() {
      const currentBlur = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--glass-blur')) || 24;
      return `
        <div class="space-y-4">
          <div class="p-4 rounded-2xl glass-inner space-y-3">
            <div class="font-semibold text-sm">Frosted Glass Appearance</div>
            <div class="flex items-center justify-between">
              <div>
                <div class="font-medium">Surface Theme</div>
                <div class="text-[11px] opacity-70">Toggle between Dark Obsidian Frost & Daylight Crystal</div>
              </div>
              <button onclick="toggleTheme(); document.getElementById('win-body-settings').innerHTML = renderSettingsApp();" class="px-3.5 py-2 rounded-xl bg-sky-500/35 hover:bg-sky-500/50 border border-sky-400/40 font-medium transition">
                ${isLightGlass ? 'Switch to Dark Glass' : 'Switch to Light Glass'}
              </button>
            </div>

            <div class="space-y-1.5 pt-2">
              <div class="flex justify-between text-[11px]">
                <span>Backdrop Blur Intensity</span>
                <span id="settings-blur-val" class="font-mono">${currentBlur}px</span>
              </div>
              <input type="range" min="6" max="42" value="${currentBlur}" oninput="updateGlassBlur(this.value)" class="w-full" />
            </div>
          </div>

          <div class="p-4 rounded-2xl glass-inner space-y-3">
            <div class="font-semibold text-sm">Atmospheric Mesh Wallpapers</div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button onclick="setWallpaper('aurora')" class="group space-y-1.5 text-center">
                <div class="h-16 rounded-2xl wallpaper-aurora border-2 ${currentWallpaper === 'aurora' ? 'border-sky-400' : 'border-white/25'} group-hover:scale-105 transition"></div>
                <span class="text-[11px]">Aurora Mesh</span>
              </button>
              <button onclick="setWallpaper('glacier')" class="group space-y-1.5 text-center">
                <div class="h-16 rounded-2xl wallpaper-glacier border-2 ${currentWallpaper === 'glacier' ? 'border-sky-400' : 'border-white/25'} group-hover:scale-105 transition"></div>
                <span class="text-[11px]">Nordic Glacier</span>
              </button>
              <button onclick="setWallpaper('sunset')" class="group space-y-1.5 text-center">
                <div class="h-16 rounded-2xl wallpaper-sunset border-2 ${currentWallpaper === 'sunset' ? 'border-sky-400' : 'border-white/25'} group-hover:scale-105 transition"></div>
                <span class="text-[11px]">Solar Dusk</span>
              </button>
              <button onclick="setWallpaper('emerald')" class="group space-y-1.5 text-center">
                <div class="h-16 rounded-2xl wallpaper-emerald border-2 ${currentWallpaper === 'emerald' ? 'border-sky-400' : 'border-white/25'} group-hover:scale-105 transition"></div>
                <span class="text-[11px]">Emerald Matrix</span>
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function updateGlassBlur(px) {
      document.documentElement.style.setProperty('--glass-blur', `${px}px`);
      const label = document.getElementById('settings-blur-val');
      if (label) label.textContent = `${px}px`;
    }

    // =========================================================================
    // 5. TOP BAR MENUS, CONTEXT MENU & ENVIRONMENT CONTROLS
    // =========================================================================
    function toggleMenu(id) {
      const target = document.getElementById(id);
      const isHidden = target.classList.contains('hidden');
      closeMenus();
      if (isHidden) target.classList.remove('hidden');
    }

    function closeMenus() {
      ['system-menu', 'control-center', 'calendar-popover'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });
    }

    document.addEventListener('click', e => {
      if (!e.target.closest('header')) closeMenus();
      if (!e.target.closest('#context-menu')) hideContextMenu();
    });

    function toggleControl(type) {
      if (type === 'wifi') {
        const status = document.getElementById('cc-wifi-status');
        const active = status.textContent !== 'Off';
        status.textContent = active ? 'Off' : 'AIM-Fiber-6E';
        showToast('Network Interface', active ? 'Wi-Fi disabled' : 'Connected to AIM-Fiber-6E');
      } else if (type === 'bt') {
        const status = document.getElementById('cc-bt-status');
        const active = status.textContent !== 'Off';
        status.textContent = active ? 'Off' : 'Active';
      }
    }

    function toggleTheme() {
      isLightGlass = !isLightGlass;
      document.body.classList.toggle('light-glass', isLightGlass);
      const label = document.getElementById('theme-mode-label');
      if (label) label.textContent = isLightGlass ? 'Daylight Crystal Frost' : 'Dark Obsidian Frost';
    }

    function setBrightness(val) {
      document.getElementById('brightness-val').textContent = `${val}%`;
      const darkness = (100 - val) / 100 * 0.75;
      document.getElementById('brightness-overlay').style.opacity = darkness;
    }

    function setWallpaper(name) {
      currentWallpaper = name;
      document.body.classList.remove('wallpaper-aurora', 'wallpaper-glacier', 'wallpaper-sunset', 'wallpaper-emerald');
      document.body.classList.add(`wallpaper-${name}`);
      const settingsBody = document.getElementById('win-body-settings');
      if (settingsBody) settingsBody.innerHTML = renderSettingsApp();
    }

    function cycleWallpaper() {
      const order = ['aurora', 'glacier', 'sunset', 'emerald'];
      const next = order[(order.indexOf(currentWallpaper) + 1) % order.length];
      setWallpaper(next);
    }

    function sleepSystem() {
      const screen = document.getElementById('sleep-screen');
      screen.classList.remove('hidden');
      screen.classList.add('flex');
    }

    function wakeSystem() {
      const screen = document.getElementById('sleep-screen');
      screen.classList.add('hidden');
      screen.classList.remove('flex');
      showToast('Welcome Back', 'Tokio & Tauri runtime resumed.', 'sky');
    }

    function restartSystem() {
      Object.keys(openWindows).forEach(closeWindow);
      showToast('AIM OS Restarted', 'All Tauri windows reinitialized.', 'emerald');
    }

    function selectDesktopIcon(btn) {
      document.querySelectorAll('.desktop-icon').forEach(el => el.classList.remove('bg-white/20'));
      btn.classList.add('bg-white/20');
    }

    function showDesktopContextMenu(e) {
      if (e.target.closest('.window-frame') || e.target.closest('#dock-bar')) return;
      e.preventDefault();
      const menu = document.getElementById('context-menu');
      menu.style.left = `${Math.min(window.innerWidth - 230, e.clientX)}px`;
      menu.style.top = `${Math.min(window.innerHeight - 210, e.clientY)}px`;
      menu.classList.remove('hidden');
    }

    function hideContextMenu() {
      document.getElementById('context-menu').classList.add('hidden');
    }

    function createNewDesktopFolder() {
      const grid = document.getElementById('desktop-icons');
      const count = grid.children.length + 1;
      const folderName = `Workspace_${count}`;
      const btn = document.createElement('button');
      btn.className = 'desktop-icon group w-24 p-2.5 rounded-2xl hover:bg-white/15 transition flex flex-col items-center gap-1.5 text-center';
      btn.ondblclick = () => openApp('explorer');
      btn.onclick = () => selectDesktopIcon(btn);
      btn.innerHTML = `
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-sky-300 to-indigo-500 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        </div>
        <span class="text-xs font-medium drop-shadow leading-tight">${folderName}</span>
      `;
      grid.appendChild(btn);

      const nowStr = new Date().toTimeString().split(' ')[0];
      notifyEvents.unshift({ time: nowStr, kind: 'Create(Folder)', path: `Desktop/${folderName}` });
      showToast('Folder Created', `notify watcher registered Desktop/${folderName}`, 'sky');
    }
  </script>
