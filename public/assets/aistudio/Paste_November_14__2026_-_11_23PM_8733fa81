            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br ${app.gradient} flex items-center justify-center shadow-lg border border-white/25">
              ${app.icon}
            </div>
            <span class="w-1.5 h-1.5 rounded-full mt-1 transition-all ${isOpen ? 'bg-white opacity-100' : 'opacity-0'}"></span>
          </button>
        `;
      }).join('');
    }

    function handleDockClick(appId) {
      const winState = openWindows[appId];
      if (!winState) {
        openApp(appId);
      } else if (winState.minimized) {
        restoreWindow(appId);
      } else if (activeAppId === appId) {
        minimizeWindow(appId);
      } else {
        focusWindow(appId);
      }
    }

    function openApp(appId) {
      if (appId === 'about') {
        openAboutWindow();
        return;
      }
      const app = APPS.find(a => a.id === appId);
      if (!app) return;

      if (openWindows[appId]) {
        restoreWindow(appId);
        focusWindow(appId);
        return;
      }

      const layer = document.getElementById('windows-layer');
      const offsetCount = Object.keys(openWindows).length;
      const isMobile = window.innerWidth < 768;
      const w = isMobile ? Math.min(window.innerWidth - 24, app.width) : Math.min(window.innerWidth - 60, app.width);
      const h = isMobile ? Math.min(window.innerHeight - 130, app.height) : Math.min(window.innerHeight - 135, app.height);
      const left = isMobile ? 12 : Math.max(40, Math.min(window.innerWidth - w - 40, 110 + offsetCount * 34));
      const top = isMobile ? 48 : Math.max(48, Math.min(window.innerHeight - h - 95, 64 + offsetCount * 28));

      const winEl = document.createElement('div');
      winEl.id = `win-${appId}`;
      winEl.className = 'window-frame glass-surface rounded-3xl flex flex-col overflow-hidden pointer-events-auto absolute';
      winEl.style.width = `${w}px`;
      winEl.style.height = `${h}px`;
      winEl.style.left = `${left}px`;
      winEl.style.top = `${top}px`;
