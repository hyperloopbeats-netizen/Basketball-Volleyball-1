    // --- APP 2: FILE EXPLORER (`notify 6.1` & `globset 0.4`) ---
    function globToRegex(glob) {
      if (!glob || glob.trim() === '' || glob.trim() === '*') return /.*/i;
      const escaped = glob.trim()
        .replace(/[.+^${}()|[\]\\]/g, '\\$&')
        .replace(/\*\*/g, '.*')
        .replace(/\*/g, '[^/]*')
        .replace(/\?/g, '.');
      return new RegExp(escaped, 'i');
    }

