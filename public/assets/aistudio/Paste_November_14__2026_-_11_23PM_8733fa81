    function toggleMaximizeWindow(appId) {
      const winEl = document.getElementById(`win-${appId}`);
      const state = openWindows[appId];
      if (!winEl || !state) return;

      if (!state.maximized) {
        state.prevRect = {
          left: winEl.style.left,
          top: winEl.style.top,
          width: winEl.style.width,
          height: winEl.style.height
        };
        winEl.style.left = '12px';
        winEl.style.top = '44px';
        winEl.style.width = `${window.innerWidth - 24}px`;
        winEl.style.height = `${window.innerHeight - 126}px`;
        state.maximized = true;
      } else if (state.prevRect) {
        winEl.style.left = state.prevRect.left;
        winEl.style.top = state.prevRect.top;
        winEl.style.width = state.prevRect.width;
        winEl.style.height = state.prevRect.height;
        state.maximized = false;
      }
    }

    function makeWindowDraggableAndResizable(winEl, appId) {
      const header = winEl.querySelector('.win-header');
      const resizer = winEl.querySelector('.win-resizer');

      // Dragging (Mouse + Touch)
      const startDrag = (clientX, clientY) => {
        if (openWindows[appId]?.maximized) return;
        winEl.classList.add('dragging');
        const startLeft = winEl.offsetLeft;
        const startTop = winEl.offsetTop;

        const onMove = (moveX, moveY) => {
          const newLeft = Math.max(-100, Math.min(window.innerWidth - 120, startLeft + (moveX - clientX)));
          const newTop = Math.max(36, Math.min(window.innerHeight - 90, startTop + (moveY - clientY)));
          winEl.style.left = `${newLeft}px`;
          winEl.style.top = `${newTop}px`;
        };

        const mouseMove = e => onMove(e.clientX, e.clientY);
        const touchMove = e => onMove(e.touches[0].clientX, e.touches[0].clientY);

        const stopDrag = () => {
          winEl.classList.remove('dragging');
          window.removeEventListener('mousemove', mouseMove);
          window.removeEventListener('mouseup', stopDrag);
          window.removeEventListener('touchmove', touchMove);
          window.removeEventListener('touchend', stopDrag);
        };

        window.addEventListener('mousemove', mouseMove);
        window.addEventListener('mouseup', stopDrag);
        window.addEventListener('touchmove', touchMove, { passive: true });
        window.addEventListener('touchend', stopDrag);
      };

      header.addEventListener('mousedown', e => {
        if (e.target.tagName === 'BUTTON') return;
        startDrag(e.clientX, e.clientY);
      });
      header.addEventListener('touchstart', e => {
        if (e.target.tagName === 'BUTTON') return;
        startDrag(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      // Resizing
      if (resizer) {
        resizer.addEventListener('mousedown', e => {
          e.stopPropagation();
          winEl.classList.add('resizing');
          const startX = e.clientX;
          const startY = e.clientY;
          const startW = winEl.offsetWidth;
          const startH = winEl.offsetHeight;

          const onResize = ev => {
            winEl.style.width = `${Math.max(340, startW + (ev.clientX - startX))}px`;
            winEl.style.height = `${Math.max(280, startH + (ev.clientY - startY))}px`;
          };
          const stopResize = () => {
            winEl.classList.remove('resizing');
            window.removeEventListener('mousemove', onResize);
            window.removeEventListener('mouseup', stopResize);
          };
          window.addEventListener('mousemove', onResize);
          window.addEventListener('mouseup', stopResize);
        });
      }
    }

