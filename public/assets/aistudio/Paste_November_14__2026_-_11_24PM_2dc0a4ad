  <!-- JAVASCRIPT MASTER ENGINE -->
  <script>
    let scene, camera, renderer, liquidMesh, particleSystem;
    let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
    let currentAppSourceCode = "";
    let savedAppVault = [];
    let appVersionHistory = [];
    let globalLeaderboardData = JSON.parse(localStorage.getItem('ps7_leaderboard') || '[]');
    let pc = null, dataChannel = null;
    const rtcConfig = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

    // 1. THREE.JS BACKGROUND
    function initMatrixSystem() {
      const container = document.getElementById('webgl-bg');
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.z = 5;

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 0.8));
      const pointLight = new THREE.PointLight(0x00a2ff, 3, 50);
      pointLight.position.set(2, 3, 4);
      scene.add(pointLight);

      const geometry = new THREE.IcosahedronGeometry(1.4, 64);
      const material = new THREE.MeshStandardMaterial({ color: 0x00a2ff, roughness: 0.15, metalness: 0.85, emissive: 0x003366, emissiveIntensity: 0.4 });
      liquidMesh = new THREE.Mesh(geometry, material);
      scene.add(liquidMesh);

      const particleGeo = new THREE.BufferGeometry();
      const count = 1200;
      const positions = new Float32Array(count * 3);
      for (let i = 0; i < count * 3; i += 3) {
        positions[i] = (Math.random() - 0.5) * 20;
        positions[i+1] = (Math.random() - 0.5) * 12;
        positions[i+2] = (Math.random() - 0.5) * 10;
      }
      particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      particleSystem = new THREE.Points(particleGeo, new THREE.PointsMaterial({ color: 0x38bdf8, size: 0.04, transparent: true, opacity: 0.7 }));
      scene.add(particleSystem);

      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth) * 2 - 1;
        mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      });

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      animateMatrixLoop();
    }

    function animateMatrixLoop() {
      requestAnimationFrame(animateMatrixLoop);
      const time = Date.now() * 0.002;
      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;
      liquidMesh.rotation.y = time * 0.3 + targetX * 1.5;
      liquidMesh.rotation.x = time * 0.2 + targetY * 1.5;
      if (particleSystem) particleSystem.rotation.y -= 0.0008;
      renderer.render(scene, camera);
    }

    // 2. VAULT & TILES
    function loadAppVault() {
      const stored = localStorage.getItem('ps7_app_vault');
      if (stored) {
        try { savedAppVault = JSON.parse(stored); } catch(e) { savedAppVault = []; }
      }
      if (savedAppVault.length === 0) {
        savedAppVault = [{
          id: 'default-tank',
          title: 'Neon Tank Arena',
          category: 'GAME',
          icon: '🚀',
          code: `<!DOCTYPE html><html lang="en"><body style="background:#020617;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;"><h1>Sample Neon Tank App</h1><button onclick="PS7Score.submit(500)" style="padding:10px 20px;background:#e11d48;color:#fff;border:none;border-radius:8px;cursor:pointer;margin-top:20px;">Submit 500 Score</button></body></html>`
        }];
      }
      renderDesktopTiles();
    }

    function renderDesktopTiles() {
      const container = document.getElementById('tile-container');
      if (!container) return;
      let html = `
        <div class="ps7-card glass-panel w-80 h-44 rounded-2xl p-5 flex flex-col justify-between cursor-pointer border border-rose-500/50 flex-shrink-0 selected" onclick="focusCompilerTile()">
          <div class="flex justify-between items-start"><span class="text-3xl">🕹️</span><span class="text-[10px] bg-rose-500/20 text-rose-300 px-2 py-0.5 rounded font-mono">PROCESSOR</span></div>
          <div><h3 class="font-bold text-sm text-white">Universal App Engine</h3><p class="text-[11px] text-slate-400 mt-1">Prompt-to-App Live Sandbox Compiler</p></div>
        </div>
      `;
      savedAppVault.forEach((app) => {
        html += `
          <div class="ps7-card glass-panel w-80 h-44 rounded-2xl p-5 flex flex-col justify-between cursor-pointer border border-white/10 hover:border-cyan-400/50 flex-shrink-0 group" onclick="launchVaultApp('${app.id}')">
            <div class="flex justify-between items-start">
              <span class="text-3xl">${app.icon || '🎮'}</span>
              <div class="flex items-center gap-2">
                <span class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded font-mono">${app.category || 'APP'}</span>
                <button onclick="event.stopPropagation(); deleteVaultApp('${app.id}')" class="text-slate-500 hover:text-rose-400 text-xs px-1">✕</button>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-sm text-white group-hover:text-cyan-300 transition">${app.title}</h3>
              <p class="text-[11px] text-slate-400 mt-1 truncate">AI Studio Compiled</p>
            </div>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    function launchVaultApp(id) {
      const app = savedAppVault.find(a => a.id === id);
      if (app) {
        currentAppSourceCode = app.code;
        launchRuntimeSandbox(app.code);
      }
    }

    function deleteVaultApp(id) {
      savedAppVault = savedAppVault.filter(a => a.id !== id);
      localStorage.setItem('ps7_app_vault', JSON.stringify(savedAppVault));
      renderDesktopTiles();
    }

    // 3. RUNTIME & INJECTION
    function launchRuntimeSandbox(htmlCode) {
      const modal = document.getElementById('compiler-runtime-modal');
      const iframe = document.getElementById('runtime-sandbox-frame');
      modal.classList.remove('hidden');

      const helpers = `
        <script>
          window.PS7Score = {
            submit: function(score, gameTitle = document.title) {
              window.parent.postMessage({ type: 'SUBMIT_SCORE', gameTitle, score }, '*');
            }
          };
          window.PS7Multiplayer = {
            send: function(payload) { window.parent.postMessage({ type: 'P2P_SEND', payload }, '*'); },
            onReceive: function(cb) {
              window.addEventListener('message', (e) => {
                if (e.data && e.data.type === 'P2P_DATA_RECEIVED') {
                  try { cb(JSON.parse(e.data.payload)); } catch(err) { cb(e.data.payload); }
                }
              });
            }
          };
          window.onerror = function(msg, url, line) {
            window.parent.postMessage({ type: 'RUNTIME_ERROR', message: msg, line: line }, '*');
            return true;
          };
        <\/script>
      `;

      const patchedHtml = htmlCode.includes('<head>') ? htmlCode.replace('<head>', '<head>' + helpers) : helpers + htmlCode;
      const blob = new Blob([patchedHtml], { type: 'text/html' });
      iframe.src = URL.createObjectURL(blob);
    }

    function closeCompilerRuntime() {
      document.getElementById('compiler-runtime-modal').classList.add('hidden');
      document.getElementById('runtime-sandbox-frame').src = 'about:blank';
    }

    // 4. COMPILER & GEMINI BRIDGE
    async function handleUniversalCompilation(promptText, apiKey) {
      if (!apiKey) {
        apiKey = localStorage.getItem('gemini_api_key') || prompt("Enter your Google AI Studio Gemini API Key:");
        if (!apiKey) return alert("API Key required.");
        localStorage.setItem('gemini_api_key', apiKey);
      }

      const selectedModel = localStorage.getItem('gemini_model') || 'gemini-2.5-flash';
      const selectedTemp = parseFloat(localStorage.getItem('gemini_temp') || '0.7');
      const logContainer = document.getElementById('swarm-log');
      if (logContainer) logContainer.innerHTML += `<div class="text-amber-400">[Compiler]: Compiling with ${selectedModel}...</div>`;

      const webglCanvas = document.querySelector('#webgl-bg canvas');
      const screenshotBase64 = webglCanvas ? webglCanvas.toDataURL('image/png').split(',')[1] : null;

      const systemInstruction = `You are an autonomous game and app compiler. Transform the browser into a fully functional, self-contained single-file HTML5 game or application. Return ONLY clean raw HTML code without markdown code fences.`;

      const userPayload = {
        contents: [{
          parts: [
            { text: `Prompt: ${promptText}. Transform into an interactive browser game.` },
            ...(screenshotBase64 ? [{ inline_data: { mime_type: "image/png", data: screenshotBase64 } }] : [])
          ]
        }],
        systemInstruction: { parts: [{ text: systemInstruction }] },
        generationConfig: { temperature: selectedTemp, maxOutputTokens: 8192 }
      };

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${selectedModel}:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(userPayload)
        });
        const data = await response.json();
        if (data.error) throw new Error(data.error.message);

        let rawHtml = data.candidates[0].content.parts[0].text;
        rawHtml = rawHtml.replace(/^```html\s*/i, '').replace(/^```\s*/i, '').replace(/\s*```$/, '');

        currentAppSourceCode = rawHtml;
        if (!promptText.startsWith('Modify')) appVersionHistory = [];
        pushVersion(rawHtml, promptText.substring(0, 20));

        savedAppVault.push({
          id: 'app-' + Date.now(),
          title: promptText.length > 25 ? promptText.substring(0, 25) + '...' : promptText,
          category: 'CUSTOM',
          icon: ['🕹️', '⚡', '🛸', '🎯', '🔮'][Math.floor(Math.random() * 5)],
          code: rawHtml
        });
        localStorage.setItem('ps7_app_vault', JSON.stringify(savedAppVault));
        renderDesktopTiles();
        launchRuntimeSandbox(rawHtml);

        if (logContainer) logContainer.innerHTML += `<div class="text-emerald-400">[Compiler]: Success!</div>`;
      } catch (err) {
        console.error(err);
        alert(`Compilation failed: ${err.message}`);
      }
    }

    async function compileAndModifyApp() {
      const input = document.getElementById('runtime-prompt-input');
      const modPrompt = input.value.trim();
      if (!modPrompt) return;
      const fullPrompt = `Modify this HTML application code according to this instruction: "${modPrompt}". Return only clean HTML.\n\nCode:\n${currentAppSourceCode}`;
      input.value = '';
      await handleUniversalCompilation(fullPrompt, localStorage.getItem('gemini_api_key'));
    }

    function handleSwarmPrompt(e) {
      e.preventDefault();
      const input = document.getElementById('swarm-input');
      const val = input.value.trim();
      if (!val) return;
      handleUniversalCompilation(val);
      input.value = '';
    }

    function quickLaunchTemplate(promptText) {
      document.getElementById('swarm-input').value = promptText;
      handleUniversalCompilation(promptText);
    }

    // 5. INSPECTOR & EXPORT & VERSIONS
    function toggleCodeInspector() {
      const drawer = document.getElementById('code-inspector-drawer');
      const textarea = document.getElementById('inspector-textarea');
      drawer.classList.toggle('hidden');
      textarea.value = currentAppSourceCode;
    }

    function applyManualCodeEdits() {
      const newCode = document.getElementById('inspector-textarea').value;
      if (!newCode) return;
      currentAppSourceCode = newCode;
      launchRuntimeSandbox(newCode);
    }

    function exportCurrentApp() {
      if (!currentAppSourceCode) return alert("No active app.");
      const blob = new Blob([currentAppSourceCode], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ps7-game-${Date.now()}.html`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function pushVersion(code, desc) {
      appVersionHistory.push({ version: appVersionHistory.length + 1, timestamp: new Date().toLocaleTimeString(), description: desc, code });
      const dropdown = document.getElementById('version-history-select');
      if (dropdown) {
        dropdown.innerHTML = appVersionHistory.map(v => `<option value="${v.version}">v${v.version} — ${v.description}</option>`).join('');
        dropdown.value = appVersionHistory.length;
      }
    }

    function rollbackToVersion(vNum) {
      const target = appVersionHistory.find(v => v.version == vNum);
      if (target) {
        currentAppSourceCode = target.code;
        launchRuntimeSandbox(target.code);
      }
    }

    function shareAppURL() {
      if (!currentAppSourceCode) return;
      const encoded = btoa(unescape(encodeURIComponent(currentAppSourceCode)));
      const shareUrl = window.location.origin + window.location.pathname + '#app=' + encoded;
      navigator.clipboard.writeText(shareUrl).then(() => alert("✨ Shareable game link copied to clipboard!"));
    }

    // 6. SETTINGS & COUNCIL & LEADERBOARD
    function toggleSettingsModal() {
      const m = document.getElementById('settings-modal');
      m.classList.toggle('hidden');
      if (!m.classList.contains('hidden')) {
        document.getElementById('settings-api-key').value = localStorage.getItem('gemini_api_key') || '';
        document.getElementById('settings-model-select').value = localStorage.getItem('gemini_model') || 'gemini-2.5-flash';
      }
    }

    function saveAppSettings() {
      const key = document.getElementById('settings-api-key').value.trim();
      if (key) localStorage.setItem('gemini_api_key', key);
      localStorage.setItem('gemini_model', document.getElementById('settings-model-select').value);
      localStorage.setItem('gemini_temp', document.getElementById('settings-temp-slider').value);
      toggleSettingsModal();
    }

    function toggleNeuralCouncilModal() { document.getElementById('neural-council-modal').classList.toggle('hidden'); }
    async function conveneNeuralCouncil() {
      if (!currentAppSourceCode) return alert("No active app.");
      const apiKey = localStorage.getItem('gemini_api_key');
      const log = document.getElementById('council-critique-log');
      log.innerHTML = `<div class="text-amber-400 animate-pulse">Convening AI Neural Council for code audit...</div>`;
      
      const prompt = `Audit and refactor this code for stability, performance, and clean game loop architecture. Return ONLY raw clean HTML without markdown fences:\n\n${currentAppSourceCode}`;
      try {
        const res = await fetch(`[https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$](https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$){apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });
        const data = await res.json();
        let refactored = data.candidates[0].content.parts[0].text.replace(/^```html\s*/i, '').replace(/^```\s*/i, '').replace(/\s*```$/, '');
        currentAppSourceCode = refactored;
        pushVersion(refactored, 'Council Refactor');
        log.innerHTML += `<div class="text-emerald-400 mt-2">Refactoring complete! Rerunning sandbox...</div>`;
        setTimeout(() => { toggleNeuralCouncilModal(); launchRuntimeSandbox(refactored); }, 1000);
      } catch(e) { log.innerHTML += `<div class="text-rose-400 mt-2">Error: ${e.message}</div>`; }
    }

    function toggleLeaderboardModal() {
      const m = document.getElementById('leaderboard-modal');
      m.classList.toggle('hidden');
      if (!m.classList.contains('hidden')) {
        document.getElementById('stat-total-games').textContent = savedAppVault.length;
        const container = document.getElementById('leaderboard-table-container');
        if (globalLeaderboardData.length === 0) {
          container.innerHTML = `<div class="text-slate-500 text-center py-4">No scores recorded yet.</div>`;
        } else {
          globalLeaderboardData.sort((a,b) => b.score - a.score);
          document.getElementById('stat-highest-score').textContent = globalLeaderboardData[0].score;
          container.innerHTML = globalLeaderboardData.map((item, idx) => `
            <div class="bg-slate-900 p-2.5 rounded-lg flex justify-between items-center text-[11px]">
              <span class="text-cyan-400 font-bold">#${idx+1} ${item.gameTitle}</span>
              <span class="text-amber-400 font-bold">${item.score} PTS</span>
            </div>
          `).join('');
        }
      }
    }

    // 7. MULTIPLAYER WEBRTC
    function toggleMultiplayerModal() { document.getElementById('multiplayer-modal').classList.toggle('hidden'); }
    function hostMultiplayerRoom() {
      pc = new RTCPeerConnection(rtcConfig);
      dataChannel = pc.createDataChannel('gameDataChannel');
      dataChannel.onopen = () => document.getElementById('mp-status-text').textContent = 'P2P Connected!';
      dataChannel.onmessage = (e) => document.getElementById('runtime-sandbox-frame').contentWindow.postMessage({ type: 'P2P_DATA_RECEIVED', payload: e.data }, '*');
      pc.onicecandidate = (e) => {
        if (!e.candidate) {
          navigator.clipboard.writeText(btoa(JSON.stringify(pc.localDescription)));
          alert("Host offer copied! Send to your peer.");
        }
      };
      pc.createOffer().then(o => pc.setLocalDescription(o));
    }
    function joinMultiplayerRoom() {
      const sdp = document.getElementById('mp-remote-sdp').value.trim();
      pc = new RTCPeerConnection(rtcConfig);
      pc.ondatachannel = (e) => {
        dataChannel = e.channel;
        dataChannel.onopen = () => document.getElementById('mp-status-text').textContent = 'P2P Connected!';
        dataChannel.onmessage = (evt) => document.getElementById('runtime-sandbox-frame').contentWindow.postMessage({ type: 'P2P_DATA_RECEIVED', payload: evt.data }, '*');
      };
      pc.setRemoteDescription(new RTCSessionDescription(JSON.parse(atob(sdp)))).then(() => {
        pc.createAnswer().then(a => {
          pc.setLocalDescription(a);
          setTimeout(() => prompt("Send answer back to host:", btoa(JSON.stringify(pc.localDescription))), 1000);
        });
      });
    }

    // EVENT LISTENERS FROM SANDBOX
    window.addEventListener('message', (e) => {
      if (!e.data) return;
      if (e.data.type === 'SUBMIT_SCORE') {
        globalLeaderboardData.push({ gameTitle: e.data.gameTitle, score: e.data.score, time: new Date().toLocaleTimeString() });
        localStorage.setItem('ps7_leaderboard', JSON.stringify(globalLeaderboardData));
      }
      if (e.data.type === 'P2P_SEND' && dataChannel && dataChannel.readyState === 'open') {
        dataChannel.send(JSON.stringify(e.data.payload));
      }
    });

    // CLOCK & INIT
    setInterval(() => {
      document.getElementById('live-clock').textContent = new Date().toTimeString().split(' ')[0].substring(0, 5);
    }, 1000);

    window.addEventListener('load', () => {
      initMatrixSystem();
      loadAppVault();
      if (window.location.hash.startsWith('#app=')) {
        try {
          const decoded = decodeURIComponent(escape(atob(window.location.hash.substring(5))));
          currentAppSourceCode = decoded;
          setTimeout(() => { pushVersion(decoded, 'Shared Link'); launchRuntimeSandbox(decoded); }, 500);
        } catch(err) { console.error(err); }
      }
    });
  </script>
</body>
